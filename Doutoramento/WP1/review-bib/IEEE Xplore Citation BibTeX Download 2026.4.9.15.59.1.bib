  author={Hartatik and Heryawan, Lukman and Pulungan, Reza},
  journal={IEEE Access}, 
  title={Trust Decay-Based Temporal Learning for Dynamic Recommender Systems With Concept Drift Adaptation}, 
  year={2025},
  volume={13},
  number={},
  pages={110955-110971},
  abstract={Modeling temporal dynamics in recommendation systems is essential for capturing drifts in user preferences over time, particularly under conditions of data sparsity and non-stationarity. In this study, we propose a novel framework, Trust Decay-based Temporal Learning (TDTL), which integrates trust region optimization, temporal regularization, and drift-aware adaptation to enhance the stability and adaptability of matrix factorization models. A key contribution of TDTL is the incorporation of bias-aware prediction and interaction-specific confidence weighting, which enables the model to capture rating tendencies and filter out noisy updates based on user-item frequency. TDTL also employs a BiGRU-based autoencoder to detect and refine temporal drift in user latent factors. Extensive experiments on nine benchmark datasets from diverse domains, including technology, health, entertainment, and social platforms, demonstrate that TDTL consistently outperforms both classical and deep learning-based baselines. For instance, TDTL reduces the root mean square error (RMSE) from 1.395 to 0.860 on the highly sparse Software dataset compared to TimeSVD++ and from 0.733 to 0.5349 on the Cellphones dataset compared to ALSTM. An ablation study further confirms that bias modeling and confidence weighting significantly contribute to predictive accuracy, particularly in extreme sparsity scenarios. These results highlight the robustness and generalization capability of TDTL as a reliable solution for real-world temporal recommendation tasks.},
  keywords={Adaptation models;Concept drift;Recommender systems;Fluctuations;User preference;Overfitting;Stability analysis;Reviews;Noise;Accuracy;Temporal recommendation;user modeling;concept drift;BiGRU autoencoder;trust region optimization},
  doi={10.1109/ACCESS.2025.3583186},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10843554,
  author={Mahmoudi, Mohsen and Taghiyareh, Fattaneh and Arian, Kianosh},
  booktitle={2024 11th International Symposium on Telecommunications (IST)}, 
  title={Effect of Short-Form Videos on Student Attention}, 
  year={2024},
  volume={},
  number={},
  pages={774-779},
  abstract={Short-form videos (SFVs) have recently emerged as one of the most prominent forms of entertainment content on social media, attracting huge audiences across platforms such as TikTok, Instagram, and YouTube. This study explores the potential effects of short-form entertainment content on cognitive functions, especially learning-related ones. We conducted an experimental study to investigate the immediate effects of SFV consumption on student learning. During the experiment, volunteers engaged in two learning tasks; they avoided watching SFVs for three hours before the first learning task and watched 15 minutes of SFVs before doing the second task. The SFV content viewed by subjects was personalized and recommended to them by their own Instagram algorithm to ensure real-world relevance. Subjects wore a Pupil Core eye-tracking device during the experiment. Subjects’ eye measures were monitored and analyzed in pre- and post-experiments to gain insight into the immediate neurophysiological effects of using Instagram on learning performance. Our findings revealed that watching SFVs negatively affects the subject’s pupil diameter, which implies reduced attention and processing load. This negative effect gradually decreases over time, and its dissipation can be modeled with an autoregression and space-state model. The study highlights that watching short entertainment videos before study sessions can impair the learning process. It could be beneficial for students to incorporate guidelines that regulate short-form video consumption before learning activities.},
  keywords={Video on demand;Social networking (online);Entertainment industry;Gaze tracking;Telecommunications;Web sites;Multimedia communication;Pupils;Videos;Load modeling;Short-Form Videos;Learning Performance;Eye-Tracking;Social Media;User Modeling},
  doi={10.1109/IST64061.2024.10843554},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10611895,
  author={Aliberti, Luca and D'Aniello, Giuseppe and Gaeta, Matteo and Marzolo, Alice},
  booktitle={2024 IEEE International Conference on Fuzzy Systems (FUZZ-IEEE)}, 
  title={A Fuzzy Signature-Based Approach for Recommendation Systems}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={In today's information-rich era, recommendation systems are essential for identifying and suggesting items tailored to user preferences. This paper introduces a recommendation approach based on Fuzzy User Signatures, enabling the development of effective recommender systems, even in scenarios where user data are limited. Fuzzy User Signatures are used to compactly represent user interests and preferences and to calculate similarity between users. The practicality and effectiveness of this fuzzy signature-based approach are showcased through its application in a movie recommendation system case study. An experimental evaluation using the MovieLens dataset demonstrates a significant improvement in performance compared to a similar state-of-the-art probability-based approach.},
  keywords={Fuzzy logic;Technological innovation;Social networking (online);Tagging;Motion pictures;Probabilistic logic;User experience;Fuzzy User Signature;User Similarity;User Modeling;Recommender System},
  doi={10.1109/FUZZ-IEEE60900.2024.10611895},
  ISSN={1558-4739},
  month={June},}@ARTICLE{10824839,
  author={Jiao, Pengfei and Song, Weijian and Wang, Yuling and Zhang, Wang and Chen, Hongqian and Zhao, Zhidong and Wu, Jian},
  journal={IEEE Transactions on Network Science and Engineering}, 
  title={Cascade Popularity Prediction: A Multi-View Learning Approach With Socialized Modeling}, 
  year={2025},
  volume={12},
  number={2},
  pages={1198-1209},
  abstract={Predicting the popularity of information in social networks poses a highly challenging problem. The popularity of a message is contingent upon its diffusion process and the relationships it maintains with other cascades and is influenced by user behaviour within the social network. Effectively capturing the dynamic process of message propagation and integrating the structural features of the social network to enhance popularity prediction constitutes a pivotal challenge. To address the challenge, we propose a novel method called “Cascade Social Net” (CSN) that leverages cascade graphs and social graphs to predict cascade popularity accurately. The proposed method consists of three stages. Firstly, we construct a social graph by collecting user information and their connections. Secondly, we integrate information from social graphs, cascade graphs and inter-cascade graphs. Finally, we leverage graph neural networks to predict the popularity of cascades. To overcome the challenge of large-scale social graphs, we introduce a novel neighbour sampling technique that efficiently aggregates information from second-order neighbours. We evaluate our method on real-world datasets and compare it with state-of-the-art methods. Our results demonstrate that CSN outperforms existing methods in predicting cascade popularity.},
  keywords={Social networking (online);Predictive models;Feature extraction;Data models;Contrastive learning;Biological system modeling;Analytical models;Context modeling;Blogs;Supervised learning;User modeling;social network analysis;graph-based Machine Learning},
  doi={10.1109/TNSE.2025.3525717},
  ISSN={2327-4697},
  month={March},}@INPROCEEDINGS{10036249,
  author={Savchenko, Andrey V.},
  booktitle={2022 IEEE 20th Jubilee International Symposium on Intelligent Systems and Informatics (SISY)}, 
  title={Recommending Restaurants based on Classification of Photos from the Gallery of Mobile Device}, 
  year={2022},
  volume={},
  number={},
  pages={431-436},
  abstract={The restaurant recommender systems are important for travelers, but may suffer from the “cold start” problem for new users. In this paper, it is assumed that photos of food in a gallery of mobile device of a user reflect his or her gastronomic preferences. The novel pipeline for modeling of the user's food preferences is introduced. At first, scene recognition neural network is used to extract photos of the restaurants from a gallery. It is proposed to train the multi-task convolutional network to predict the presence of food in an input image and the attributes of the restaurant. The recognized types of cuisine are summarized in a profile of gastronomic preferences of the user. The restaurants in a given city are recommended based on these preferences and additional attributes of a restaurant such as cumulative rating. Experimental study for the Yelp datasets is provided. Several neural network architectures are compared, among which EfficientNet models demonstrated the best performance.},
  keywords={Performance evaluation;Protocols;Neural networks;Urban areas;Pipelines;Predictive models;Prediction algorithms;user modeling;recommender system;cold start problem;scene recognition;multi-task learning},
  doi={10.1109/SISY56759.2022.10036249},
  ISSN={1949-0488},
  month={Sep.},}@ARTICLE{10086610,
  author={Quintero, Luis and Fors, Uno and Papapetrou, Panagiotis},
  journal={IEEE Transactions on Games}, 
  title={Personalized Feature Importance Ranking for Affect Recognition From Behavioral and Physiological Data}, 
  year={2025},
  volume={17},
  number={3},
  pages={594-603},
  abstract={Designing affect-based personalized technology involves dealing with large datasets. Machine learning (ML) algorithms are employed to predict affect and similar human factors from in-game metrics, behavioral patterns, or physiological responses. The classification performance is usually presented as a global point estimate without providing user-specific interpretations. This approach is incompatible with effective personalization in games because it disregards the variability of body responses between players. This article proposes a methodology to classify subjective human factors from large multimodal data. A public VR dataset (CEAP-360VR) was used to extensively compare three ML classifiers and five feature importance techniques. The produced models could reduce the original feature space by 82% (from 113 to 20 features) without compromising predictive performance (F1 score). A random forest (RF) using forward sequential feature selection (fSFS) yielded the best prediction of binary valence (F1 = 0.761) and arousal (F1 = 0.748). Finally, feature importance rankings are discussed with an emphasis on global and user-specific patterns that may improve affect recognition. The proposed methodology is envisioned to help game designers and researchers create customized user-centric games and VR experiences by inferring possible explanations from multimodal datasets.},
  keywords={Games;Feature extraction;Behavioral sciences;Physiology;Classification algorithms;Solid modeling;Skin;Affect;arousal;artificial intelligence (AI);emotional modeling;explainable artificial intelligence (XAI);feature importance;machine learning (ML);movement;physiology;user modeling;user tracking;valence;virtual reality (VR)},
  doi={10.1109/TG.2023.3263070},
  ISSN={2475-1510},
  month={Sep.},}@INPROCEEDINGS{10892676,
  author={Mahmoudi, Mohsen and Taghiyareh, Fattaneh and Akhavein, Yasamin and Ghorbani, Elnaz},
  booktitle={2024 15th International Conference on Information and Knowledge Technology (IKT)}, 
  title={Real-Time EEG-Based Analysis of Stress-Inducing Stimuli}, 
  year={2024},
  volume={},
  number={},
  pages={101-107},
  abstract={The significance of understanding stress responses has gained increasing attention due to its profound impact on mental health and cognitive functioning. Prior studies have explored the potential of electroencephalography (EEG) in detecting stress, focusing on brain wave patterns like alpha and beta waves. There is a recognized need for the development of advanced methods that can offer real-time classification of stress induced by a wide range of stimuli. This research aims to develop a robust real-time EEG-based classification system to detect and analyze stress levels in response to various stress-inducing tasks. The methodology involved collecting EEG signals and analyzing them through signal processing and machine learning techniques. The Random Forest and Support Vector Machine (SVM) models were employed, achieving accuracies of 71% and 67% respectively. The model displayed a high level of precision in identifying stress. The results indicate that different stressors elicit distinct EEG patterns, with cognitive tasks engaging the frontal brain regions more intensely, while emotional tasks show reduced frontal activity. The model's performance highlights its potential for real-time applications in stress management and mental health monitoring. These findings underscore the effectiveness of EEG in real-time stress detection and pave the way for more adaptive and personalized stress management systems.},
  keywords={Support vector machines;Electric potential;Adaptation models;Adaptive systems;Anxiety disorders;Human factors;Mental health;Brain modeling;Electroencephalography;Real-time systems;Electroencephalography;Real-Time Stress Detection;Machine Learning;User Modeling},
  doi={10.1109/IKT65497.2024.10892676},
  ISSN={2476-2180},
  month={Dec},}@INPROCEEDINGS{9679933,
  author={Kelen, Domokos M. and Benczúr, Andras A.},
  booktitle={2021 International Conference on Data Mining Workshops (ICDMW)}, 
  title={A probabilistic perspective on nearest neighbor for implicit recommendation}, 
  year={2021},
  volume={},
  number={},
  pages={27-35},
  abstract={Over the past years, the recommender systems community invented several novel approaches that reached better and better prediction accuracy. Remarkably, however, the classic k nearest neighbor algorithm appears to remain competitive, even when compared to much more sophisticated methods. In this paper, we attempt to explain the inner workings of the nearest neighbor using probabilistic tools, treating similarity as conditional probability and presenting a novel model for explaining and removing popularity bias.First, we provide a probabilistic formulation of similarity and the classic prediction formula. Second, by modeling user behavior as a combination of personal preference and global influence, we are able to explain the presence of popularity bias in the predictions. Finally, we utilize Bayesian inference to construct a theoretically grounded variant of the widely used inverse frequency scaling, which we use to mitigate the effect of popularity bias in the predictions.By replacing the formerly ad hoc choices of nearest neighbor with probabilistically founded counterparts, we are able to improve prediction accuracy over a variety of data sets and gain an increased understanding of the theory behind the method.},
  keywords={Uncertainty;Predictive models;Nearest neighbor methods;Probabilistic logic;Prediction algorithms;Data models;Bayes methods;recommender systems;implicit feedback;nearest neighbor;user modeling;Bayesian inference;ranking},
  doi={10.1109/ICDMW53433.2021.00011},
  ISSN={2375-9259},
  month={Dec},}@ARTICLE{10955185,
  author={Zhou, Xiao and Zhao, Zhongxiang and Guo, Hanze},
  journal={IEEE Transactions on Knowledge and Data Engineering}, 
  title={Tricolore: Multi-Behavior User Profiling for Enhanced Candidate Generation in Recommender Systems}, 
  year={2025},
  volume={37},
  number={7},
  pages={4349-4360},
  abstract={Online platforms aggregate extensive user feedback across diverse behaviors, providing a rich source for enhancing user engagement. Traditional recommender systems, however, typically optimize for a single target behavior and represent user preferences with a single vector, limiting their ability to handle multiple important behaviors or optimization objectives. This conventional approach also struggles to capture the full spectrum of user interests, resulting in a narrow item pool during candidate generation. To address these limitations, we present Tricolore, a versatile multi-vector learning framework that uncovers connections between different behavior types for more robust candidate generation. Tricolore's adaptive multi-task structure is also customizable to specific platform needs. To manage the variability in sparsity across behavior types, we incorporate a behavior-wise multi-view fusion module that dynamically enhances learning. Moreover, a popularity-balanced strategy ensures the recommendation list balances accuracy with item popularity, fostering diversity and improving overall performance. Extensive experiments on public datasets demonstrate Tricolore's effectiveness across various recommendation scenarios, from short video platforms to e-commerce. By leveraging a shared base embedding strategy, Tricolore also significantly improves the performance for cold-start users.},
  keywords={Recommender systems;Training;User preference;Electronic commerce;Social networking (online);Accuracy;Predictive models;Optimization;Multitasking;Message services;Multi-behavior recommendation;candidate generation;user modeling;learning to rank;deep learning},
  doi={10.1109/TKDE.2025.3558503},
  ISSN={1558-2191},
  month={July},}@INPROCEEDINGS{10601801,
  author={Sankari, S. and Priscila, S. Silvia},
  booktitle={2024 International Conference on Advances in Computing, Communication and Applied Informatics (ACCAI)}, 
  title={EmoNet Deep Learning for Emotion Classification in Social Media Content Analysis}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={Recent developments in emotion classification for social media content evaluation have exposed the limitations of traditional machine learning (ML) algorithms, which struggle to represent the complex complexity of human emotions in text. In response, EmoNet, a novel deep learning technique, has been developed to deal with these problematic circumstances effectively. EmoNet combines convolutional neural network (CNN) and bidirectional long short-time period memory (Bi-LSTM) layers to extract hierarchical representations from text, enabling it to detect complex emotional indicators in social media communications. EmoNet adapts more easily to varied datasets and language patterns seen in social media since it does not require guide function engineering. EmoNet consistently outperforms existing systems in accuracy, precision, and recall across numerous emotion categories, such as happiness, sadness, anger, surprise, and disgust, as evidenced by detailed studies of benchmark datasets. For example, EmoNet achieved an accuracy of 0.85, precision of 0.87, recall of 0.84, and F1 Score of 0.85, greatly exceeding existing systems. These effects demonstrate EmoNet’s high functionality in knowledge and emotion classification, making it an essential tool for sentiment evaluation and user behaviormodeling in online platforms.},
  keywords={Deep learning;Sentiment analysis;Accuracy;Social networking (online);Training data;Benchmark testing;Robustness;EmoNet;deep learning;emotion classification;social media;sentiment analysis;user modeling},
  doi={10.1109/ACCAI61061.2024.10601801},
  ISSN={},
  month={May},}@INPROCEEDINGS{9894599,
  author={Zhang, Yihong and Shirakawa, Masumi and Hara, Takahiro},
  booktitle={2022 12th International Congress on Advanced Applied Informatics (IIAI-AAI)}, 
  title={Cross-Domain Event Participant Prediction with Public Event Description}, 
  year={2022},
  volume={},
  number={},
  pages={33-38},
  abstract={Event participant prediction is an important problem when planning future events. Previous works have found that cold-start recommendation techniques can be used to solve the problem effectively. However, we consider the case of a newly started domain where training data for learning the recommendation model is limited. We propose to use a support domain data that has a similar user behavior model to help improve the training process. Our assumption does not involve linked users across domains, but uses public event description as the bridge. We show how such data can be combined with the target domain data under such assumptions. Experimental evaluation with real-world event participation datasets shows that adding a support domain data with our method does steadily improve prediction accuracy in the target domain.},
  keywords={Training;Deep learning;Bridges;Neural networks;Training data;Data models;Planning;event-based system;recommendation;cross-domain user modeling},
  doi={10.1109/IIAIAAI55812.2022.00017},
  ISSN={2472-0070},
  month={July},}@INPROCEEDINGS{10345898,
  author={Kontogianni, Aristea and Alepis, Efthimios},
  booktitle={2023 14th International Conference on Information, Intelligence, Systems & Applications (IISA)}, 
  title={Social Network Data Enabling Smart Tourism}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Smart Tourism is a concept that has been around for some years now, with its popularity being demonstrated by the explosion of published and online resources devoted to the subject. After conducting extensive research in the field of smart tourism, we focused our attention on the value of data collected from social media platforms within this sector. The purpose of this research is to illustrate, on the basis of the policies that are currently in place, which raw data can be mined from some of the most popular social media platforms as well as their importance in the context of smart tourism. We provide evidence in support of our claim regarding the significance of certain data, as well as methods for analyzing and exploiting such data, with the end goal of ultimately developing viable smart tourism user models.},
  keywords={Privacy;Analytical models;Social networking (online);Blogs;Multimedia Web sites;Media;Data models;smart tourism;social media data;user modeling},
  doi={10.1109/IISA59645.2023.10345898},
  ISSN={},
  month={July},}@INPROCEEDINGS{10334913,
  author={Varasteh, Meysam and Nejad, Mehdi Soleiman and Moradi, Hadi and Sadeghi, Mohammad Amin and Kalhor, Ahmad},
  booktitle={2023 31st International Conference on Electrical Engineering (ICEE)}, 
  title={An Improved Hybrid Recommender System: Integrating Document Context-Based and Behavior-Based Methods}, 
  year={2023},
  volume={},
  number={},
  pages={881-887},
  abstract={One of the main challenges in recommender systems is data sparsity, which leads to high variance. Several attempts have been made to improve the bias-variance trade-off using auxiliary information. In particular, document modeling-based methods have improved the model's accuracy by using textual data such as reviews, abstracts, and storylines when the user-to-item rating matrix is sparse. However, such models are insufficient to learn optimal representation for users and items. For building recommender systems, user-based and item-based collaborative filtering have long been used due to their efficiency. A user and item profile are created based on their historically interacted items and the users who interacted with the target item. In spite of the fact that these two approaches have been studied separately, there has been little research into combining them. The purpose of this study is to combine these two approaches by considering the opinions of users on these items. Each user is represented by their historical behavior, while each item is represented by the users who have interacted with it before, combined with contextual information, which is processed with NLP. The proposed algorithm is implemented and tested on three real-world datasets that demonstrate our model's effectiveness over the baseline methods.},
  keywords={Electrical engineering;Analytical models;Collaborative filtering;Buildings;Predictive models;Data models;Behavioral sciences;Recommender Systems;Matrix Factorization;CNN;User Modeling;Contextual Information},
  doi={10.1109/ICEE59167.2023.10334913},
  ISSN={2642-9527},
  month={May},}@ARTICLE{9911618,
  author={Lo, Pei-Chi and Lim, Ee-Peng},
  journal={IEEE Access}, 
  title={Your Cursor Reveals: On Analyzing Workers’ Browsing Behavior and Annotation Quality in Crowdsourcing Tasks}, 
  year={2025},
  volume={13},
  number={},
  pages={124792-124806},
  abstract={In this work, we investigate the connection between browsing behavior and task quality of crowdsourcing workers performing annotation tasks that require information judgements. Such information judgements are often required to derive ground truth answers to information retrieval queries. We explore the use of workers’ browsing behavior to directly determine their annotation result quality. We hypothesize user attention to be the main factor contributing to a worker’s annotation quality. To predict annotation quality at the task level, we model two aspects of task-specific user attention, also known as general and semantic user attentions. Both aspects of user attention can be modeled using different types of browsing behavior features but most previous research mostly focuses on the former. This work therefore proposes to model semantic user attention by capturing the worker’s understanding of task content using task-semantics specific behavior features. We develop a web-based annotation interface for gathering user behavior data when workers perform a knowledge path retrieval task. With the collected data, we train several prediction models using behavior features corresponding to different aspects of user attention and conduct experiments on a set of annotation tasks performed by 51 Amazon Mechanical Turk workers. We show that the prediction model using both general and semantic user attention features can achieve the best performance of nearly 75% accuracy.},
  keywords={Modeling;Annotations;Behavioral sciences;Semantics;Crowdsourcing;Machine learning;Data models;Crowdsourcing;machine learning;annotations;user modeling;empirical study},
  doi={10.1109/ACCESS.2022.3212080},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10488275,
  author={Abel, Edward and Goddard, Andrew},
  booktitle={2023 15th International Congress on Advanced Applied Informatics Winter (IIAI-AAI-Winter)}, 
  title={A Live Concert Performance Recommender System Utilizing User Ideal and Antithesis Ideal Setlist Preferences}, 
  year={2023},
  volume={},
  number={},
  pages={330-335},
  abstract={Recommender systems look to curate personalized content and have become a ubiquitous part of our digital lives, including within the music domain. At the same time, numerous high quality live concert performances from illustrious music artists are becoming readily available, providing fans with an unwieldly abundance of choice. Whereas much work has explored music recommendation for tasks such as choosing songs for personalized playlist curation, the task of historic live music performance recommendation is less explored. Thus, in this paper we propose CPR, a Concert Performance Recommender system for historic live concert performance recordings. CPR provides an artist's fan the ability to define preferences via the notion of ideal setlist songs, denoting songs that would be part of an ideal concert, and negative ideal setlist songs, denoting songs that would represent part of the antithesis of an ideal concert for the user. The user can then define additional semantic information regarding why the ideal and negative ideal setlist songs have been chosen. This information is then utilized to recommend live concerts by the artist that are most aligned to the user's preferences. A user is provided with explanations regarding the whys behind potential recommendations, in terms of the alignment to his/her preferences. Such explainability aids a user to then interactively explore and fine tune their preferences and recommendation results.},
  keywords={Fans;Analytical models;Semantics;Information retrieval;Recording;Task analysis;Informatics;Recommender Systems;Multi-criteria Decision Analysis;TOPSIS;User Modeling;Music Information Retrieval},
  doi={10.1109/IIAI-AAI-Winter61682.2023.00067},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10530669,
  author={Panigrahi, Bhawani Sankar and Joyce, K J Hannah and Punna, Tejasri and Varala, Baby Keerthana and Madhavi, B K},
  booktitle={2024 1st International Conference on Cognitive, Green and Ubiquitous Computing (IC-CGU)}, 
  title={Emotional Intelligence-Based Music Recommendation System Using Hybrid Deep Neural Network}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This research focuses on advancing emotion recognition techniques, particularly in predicting arousal and valence from multi-channel signals. This study aims to advance techniques in emotion recognition, with a specific focus on the prediction of arousal and valence from multi-channel signals. The resulting emotional states serve as valuable input, seamlessly integrated into collaborative or content-based recommendation engines to enrich their capabilities with nuanced emotional information. The research contributes significantly to the broader field of affective computing, striving to create more sophisticated and emotionally intelligent systems that effectively cater to user preferences and needs. To achieve this, we propose a hybrid deep neural network architecture that combines Convolutional Neural Networks (CNNs), Recurrent Neural Networks (RNNs), and Feedforward Neural Networks to learn intricate patterns of emotion. Emotions, being affective states reflecting an individual's response to mental stimuli, play a central role in this investigation. The primary objective is facilitating the transition towards neutral or positive emotional states, such as Joy and Trust, particularly in patients. For the identification of targeted emotions, we employ a Convoluted Neural Network (CNN) model, trained on meticulously curated datasets containing annotated emotion-labeled audio clips. These clips transform Mel Frequency Spectrograms (MFS) for effective classification based on the specific emotions they represent.},
  keywords={Emotion recognition;Analytical models;Recurrent neural networks;Collaborative filtering;Predictive models;Feature extraction;Ubiquitous computing;Affective Computing;Recommender Systems;Emotion-Aware Technology;Physiological Signal Processing;Arousal and Valence Prediction;User Modeling;Galvanic Skin Response Analysis;Photo Plethysmography for Emotion Recognition;Machine Learning in Emotion-aware Systems;Multimodal Emotion Sensing},
  doi={10.1109/IC-CGU58078.2024.10530669},
  ISSN={},
  month={March},}@INPROCEEDINGS{11264983,
  author={Kumar, Krishna and Kumar, Abhishek and Ahuja, Sachin},
  booktitle={2025 International Conference on Intelligent and Secure Engineering Solutions (CISES)}, 
  title={A Review of Approaches and Challenges in Recommender Systems: From Classical Algorithms to Deep Learning Hybrids}, 
  year={2025},
  volume={},
  number={},
  pages={1320-1327},
  abstract={This Systematic Literature Review (SLR) considers 85 peer-reviewed articles between 2019 and 2025, providing an overall insight into advancements in recommender systems (RS). The review centers around three main recommendation methods—Collaborative Filtering (CF), Content-Based Filtering (CBF), and Hybrid Filtering (HBF)—with explorations of recent developments related to deep learning, graph neural networks, and trust-aware methods. The most common challenges like cold-start, sparsity of data, scalability, over-specialization, and privacy are exhaustively classified and treated. Among the 85 reviewed studies, approximately 45% employed CF methods, 33% adopted hybrid filtering, 13% focused on CBF, and the remainder explored deep learning or graph-based approaches. The discussion of how hybrid methods and privacy-enhancing methods like federated learning and explainable AI are critical to surmount these limitations is presented. Benchmark datasets like MovieLens, Amazon Product Review, and Netflix Prize are treated in their application for model ranking. Also, commonly employed measures of effectiveness like RMSE, MAE, Precision, and NDCG are examined together with measures of fairness, diversity, and novelty. The review highlights a move from traditional algorithms to intelligent, transparent, and human-centered systems and presents avenues of future directions centered around adaptability, ethical personalization, and interdisciplinarity.},
  keywords={Deep learning;Measurement;Ethics;Filtering;Federated learning;Explainable AI;Scalability;Diversity reception;Recommender systems;Systematic literature review;Recommender systems;Collaborative filtering;Content-based filtering;Hybrid filtering;Systematic literature review;Deep learning;Cold-start problem;Data sparsity;Evaluation metrics;Explainable AI;Trust-aware recommendation;Privacy preservation;Federated learning;User modeling},
  doi={10.1109/CISES66934.2025.11264983},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10970368,
  author={Dudzik, Bernd and Hrkalovic, Tiffany Matej and Hao, Chenxu and Raman, Chirag and Tsfasman, Masha},
  booktitle={2024 12th International Conference on Affective Computing and Intelligent Interaction Workshops and Demos (ACIIW)}, 
  title={Indeterminacy in Affective Computing: Considering Meaning and Context in Data Collection Practices}, 
  year={2024},
  volume={},
  number={},
  pages={181-185},
  abstract={Automatic Affect Prediction (AAP) uses computational analysis of input data such as text, speech, images, and physiological signals to predict various affective phenomena (e.g., emotions or moods). These models are typically constructed using supervised machine-learning algorithms, which rely heavily on labeled training datasets. In this position paper, we posit that all AAP training data are derived from human Affective Interpretation Processes (AIPs resulting in a form of Affective Meaning. Research on human affect indicates a form of complexity that is fundamental to such meaning: it can possess what we refer to here broadly as Qualities of Indeterminacy (QIs)-encompassing Subjectivity (meaning depends on who is making the interpretation), Uncertainty (there is a lack of confidence regarding its correctness), Ambiguity (meaning can contain mutually exclusive concepts) and Vagueness (meaning can be situated at different levels in a nested hierarchy). Failing to appropriately consider QIs in AAP leads to results incapable of meaningful and reliable predictions in real-world settings. Based on this premise, our core argument is that a crucial step in adequately addressing indeterminacy in AAP is the development of data collection practices for modeling corpora that involve the systematic consideration of 1) a relevant set of QIs, and 2) context for the associated interpretation processes. To this end, we are 1) outlining a conceptual model of AIPs and the QIs associated with the meaning these produce, in addition to a conceptual structure of relevant context, supporting understanding of its role. Finally, we use our framework for 2) discussing examples of context-sensitivity-related challenges for addressing QIs in data collection setups. We believe our efforts can stimulate a structured discussion of both the role of aspects of indeterminacy and context in research on AAP, informing the development of better practices for data collection and analysis.},
  keywords={Training;Affective computing;Uncertainty;Systematics;Training data;Data collection;Prediction algorithms;Physiology;Reliability;Context modeling;Affective Computing;Ambiguity;Subjectivity;Context-awareness;User-modeling;Date Collection},
  doi={10.1109/ACIIW63320.2024.00036},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11228512,
  author={Chen, Xinyu and Huang, Xianying and Liu, Fengjin and Li, Huan},
  booktitle={2025 International Joint Conference on Neural Networks (IJCNN)}, 
  title={Collaborative Enhancement of Long-term and Short-term Interests with Diffusion Optimization for Conversational Recommendation}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={As one of the important research areas in human-computer interaction, conversational recommendation systems aim to provide users with personalized and efficient recommendation services. Accurately capturing and understanding user preferences during the conversational recommendation process is key to achieving effective recommendations, directly impacting system performance and user experience. However, existing methods face limitations in capturing user preferences due to their reliance on current context, and they struggle to handle redundant or low-confidence relationships in knowledge graphs, resulting in decreased accuracy and reliability of recommendations. Moreover, the lack of diversity in generated conversational responses affects user satisfaction to some extent. To address these challenges, this study proposes a novel conversational recommendation system that improves recommendation accuracy and enhances response diversity and coherence through the collaborative enhancement of long-term and short-term interests and diffusion optimization. Specifically, we construct user affinity networks from the dataset to establish users’ long-term stable interests, effectively combining them with short-term immediate interests in the current conversation to comprehensively capture changes in user preferences. Additionally, a diffusion model is introduced to optimize the knowledge graph by removing invalid or low-confidence relationships, enhancing its reliability and effectiveness for more accurate recommendations. Finally, we design a semantic-noise-based diffusion semantic BERT model to deeply model conversational data, improving response diversity and user satisfaction. Extensive experiments have demonstrated the effectiveness of our approach.},
  keywords={Accuracy;Diversity reception;Collaboration;Knowledge graphs;Coherence;Diffusion models;Data models;Reliability;Recommender systems;Optimization;Conversational Recommender Systems;Knowledge Graph;Diffusion Model;Pre Trained Model;User Modeling},
  doi={10.1109/IJCNN64981.2025.11228512},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{10098016,
  author={Shayan, Parisa and Atzmueller, Martin and Van Zaanen, Menno},
  booktitle={2022 IEEE 34th International Conference on Tools with Artificial Intelligence (ICTAI)}, 
  title={Assessing the Influence of Time on Features for the Prediction of User Dropout}, 
  year={2022},
  volume={},
  number={},
  pages={1022-1027},
  abstract={This article investigates the influence of time on features for the prediction of user dropout in an online training platform. Specifically, we target a comparison between the two time measurements: activity-based versus duration-based. Considering time, we utilize features in different groups: either activity-based features for activities or duration-based features for duration, as well as the start-based, action-type-based, and course-based features for both time measurements. The most surprising aspect of the results is the high accuracy of the classifiers from the tenth activity (which corresponds to almost half a day on average) onward. While the action-type-based and the course-based features have a major influence on dropout, the start-based features are only influential in the classifiers that use information of activities at beginning. In addition, the activity-based features have only a minor impact in the middle of the course whilst the duration-based features have a major influence throughout the course.},
  keywords={Training;Predictive models;Time measurement;Data models;Data mining;Task analysis;Artificial intelligence;User Modeling;Feature Construction;User Dropout Prediction;Educational Data Mining},
  doi={10.1109/ICTAI56018.2022.00156},
  ISSN={2375-0197},
  month={Oct},}@INPROCEEDINGS{11142419,
  author={Wu, Chuyang and Jokinen, Jussi P.P.},
  booktitle={2025 17th International Conference on Human System Interaction (HSI)}, 
  title={Simultaneous Inference of Preference and Expertise for Adaptive Interaction}, 
  year={2025},
  volume={},
  number={},
  pages={01-08},
  abstract={Adaptive interfaces needs to untangle confounded user traits-like preference versus expertise-from sparse behavioral data. We present an Approximate Bayesian Inverse Reinforcement Learning (ABIRL) framework that models users as bounded-rational agents and uses Approximate Bayesian Computation to jointly infer multiple latent parameters. By matching low-dimensional summaries of simulated and observed trajectories, ABIRL recovers posterior distributions over both preference and expertise, rather than collapsing to a single esti-mate. Through a series of controlled grid-world experiments and a human-subject study, we demonstrate reliable disentanglement of these intertwined factors and show that uncertainty-aware intervention policies-grounded in the inferred posteriors-lead to safer, more effective adaptive assistance.},
  keywords={Human computer interaction;Adaptation models;Adaptive systems;Computational modeling;Collaboration;Reinforcement learning;Bayes methods;Trajectory;Reliability;Human-computer interaction;User modeling;Collaborative human-computer systems},
  doi={10.1109/HSI66212.2025.11142419},
  ISSN={2158-2254},
  month={July},}@INPROCEEDINGS{11434138,
  author={A, Devisree. and Hency Juliet, A.},
  booktitle={2026 9th International Conference on Electronics, Materials Engineering & Nano-Technology (IEMENTech)}, 
  title={Graph-Based Multimodal DQN with Ranking Aware Learning for News Recommendation}, 
  year={2026},
  volume={9},
  number={},
  pages={1-6},
  abstract={Personalized news recommender systems try to show users relevant articles by learning their interests from past interactions and news content. However, many existing methods find it difficult to model complex user–news relationships, combine different types of information, and generate well-ranked news lists as user interests change over time. To overcome these issues, the novelty includes combining graph-based learning, multimodal Deep Q-learning, and ranking-aware methods to better understand user–news interactions, learn user behavior over time, and directly improve the ranking of recommended news articles. The proposed approach improves news recommendation by jointly considering user–news interactions, sequential behavior, and ranked presentation to achieve better accuracy. In comparison to existing recommender models, the proposed approach outperforms by capturing intricate user–news relationships, modeling evolving user behavior, and producing higher-quality ranked recommendation lists. Experimental evaluation on benchmark datasets demonstrates the effectiveness of the proposed method, achieving nDCG@10 (Normalized Discounted Cumulative Gain) of 0.4209, Precision@10 of 0.1350, F1-score of 0.2153, MRR (Mean Reciprocal Rank), of 0.3827, AUC (Area Under the ROC Curve) of 0.6753, and CTR (Click-Through Rate) of 0.0406, while consistently outperforming state-of-the-art baseline models across multiple ranking-base d evaluation metrics.},
  keywords={Training;Measurement;Adaptation models;Accuracy;Q-learning;Performance metrics;Real-time systems;Graph neural networks;Recommender systems;Optimization;News Recommendation;Personalized Recommendation;Reinforcement Learning;Deep Q-Network;Graph Neural Networks;Learning to Rank;Multimodal Representation;User Modeling},
  doi={10.1109/IEMENTech202669403.2026.11434138},
  ISSN={2767-9934},
  month={Feb},}@INPROCEEDINGS{11114268,
  author={Alves, Patrícia and Coelho, Raul and Neto, Joana and Conceição, Luís and Marreiros, Goreti},
  booktitle={2025 IEEE Conference on Games (CoG)}, 
  title={Coin Catcher: A Mobile Serious Game to Predict the Morality Personality Trait}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={The use of personality to predict user preferences or select a job candidate are practical examples of how personality can be used in a variety of fields. But to assess someone's personality is not easy. The most commonly used techniques are personality questionnaires, but they are subject to social desirability bias and false responses, limiting the accuracy of personality assessment. Implicit techniques have also been used, but they require great amounts of user interactions with the system, and most of them only focus on broader personality dimensions. To overcome those limitations, we developed a short-duration mobile serious game, Coin Catcher, as a concept proof to implicitly measure the granular personality trait morality in less than 5 min. The game uses concepts related to normative morality, proposing dilemmas that the player must solve in order to progress in the game. Experiments with real users were conducted ($n=96$), showing morality can be implicitly determined by a simple game in a short period of time, without the bias associated with personality questionnaires. Additionally, correlations with other personality traits, such as altruism, cooperation, modesty, sympathy, and anger were also found, showing the game has the potential to measure several granular personality traits that better characterize a person.},
  keywords={Limiting;Correlation;Accuracy;Games;Predictive models;Serious games;morality;Big Five;personality acquisition;serious games;user modeling},
  doi={10.1109/CoG64752.2025.11114268},
  ISSN={2325-4289},
  month={Aug},}@INPROCEEDINGS{11436899,
  author={Wan, Huiying and Gong, Yanan},
  booktitle={2026 5th International Conference on Communication, Computing and Electronics Systems (ICCCES)}, 
  title={CogRec: Neural Cognitive-Style Modeling for Adaptive Learning Path Recommendation in Communication-Centric Environments}, 
  year={2026},
  volume={},
  number={},
  pages={2244-2250},
  abstract={In online learning platforms, intelligent recommendation algorithms are now an essential tool for boosting individualized learning experiences and increasing learning effectiveness. However, current approaches frequently ignore the cognitive distinctions across learners, which leads in recommendation outcomes that are not sufficiently flexible. This study suggests the CogRec (Cognitive Style-Aware Neural Recommendation) model as a solution to this problem. This model uses adaptive path optimization and multimodal cognitive style modeling to dynamically suggest learning paths. Eye movement signals, electroencephalogram (EEG) patterns, microexpression features, and learning behavior records are all used by CogRec to create a cognitive style vector. Additionally, it uses a self-attention technique to combine multimodal elements. At the modeling level, the model combines an extended restricted Boltzmann machine (RBM) with an attention-based heterogeneous graph neural network (A-HGNN). This approach captures the complex relationship between users and learning resources. Then, a cognitive style adaptation function is introduced to dynamically adjust the recommendation list based on task difficulty and individual processing preferences. This allows for the generation of personalized learning paths that are highly tailored to the learner's characteristics. The experimental part is verified based on two open education datasets (EdNet, MOOCCube) and a self-built multimodal dataset (CogLearn). At the same time, it is compared with four baseline methods: BPRMF, GRU4Rec, LightGCN and DGSR. Multi-dimensional indicators such as Precision@K, Recall@K, NDCG@K, ItemCoverage and Average-Popularity are used for comprehensive evaluation. The results show that CogRec outperforms the baseline model in accuracy and diversity indicators on all datasets. On the CogLearn dataset, CogRec's NDCG@10 is improved by about 36.5 % compared with DGSR, and it achieves the best performance in diversity and novelty indicators. The results of the ablation experiment further show that removing the cognitive style encoding module will result in a 21.7 % reduction in NDCG@10.},
  keywords={Adaptation models;Computational modeling;Reinforcement learning;Brain modeling;Vectors;Graph neural networks;Encoding;Electroencephalography;Telecommunication computing;Optimization;Cognitive Style Recognition;Neural Recommendation Mode;User Modeling;Reinforcement Learning;Explainable Recommendation},
  doi={10.1109/ICCCES62661.2026.11436899},
  ISSN={},
  month={Jan},}@ARTICLE{9943550,
  author={Ishikawa, Yuichi and Legaspi, Roberto and Yonekawa, Kei and Nakamura, Yugo and Ishida, Shigemi and Mine, Tsunenori and Arakawa, Yutaka},
  journal={IEEE Access}, 
  title={Unsupervised Learning of Domain-Independent User Attributes}, 
  year={2022},
  volume={10},
  number={},
  pages={119649-119665},
  abstract={Learning user attributes is essential for providing users with a service. In particular, for e-commerce portals which deal in variety of goods ranging from clothes to foods to home electronics, it is especially important to learn “domain-independent” attributes such as age, gender, and personality that affect people’s behavior across various domains of daily life (e.g., clothing, eating and housing) because these attributes can be used for personalization in diverse domains their service covers. Thus far, researchers have proposed approaches to learn user representation (UR) from user-item interactions, trying to embed rich information about user attributes in UR. However, very few can learn URs that are domain-independent without confounding them with domain-specific attributes (e.g., food preferences). This could consequently undermine the former’s utility for personalizing services in other domains from which the URs are not learned. To address this, we propose an approach to learn URs that exclusively reflect domain-independent attributes. Our approach introduces a novel multi-layer RNN with two types of layers: Domain Specific Layers (DSLs) for modeling behavior in individual domains and a Domain Independent Layer (DIL) for modeling attributes that affect behavior across multiple domains. By exchanging hidden states between these layers, the RNNs implement the process of domain-independent attributes affecting domain-specific behavior and makes the DIL learn URs that capture domain-independence. Our evaluation results confirmed that the URs learned by our approach have greater utility in predicting behavior in the other domains from which these URs were not learned thereby demonstrating adaptability to various domains.},
  keywords={DSL;Behavioral sciences;Electronics packaging;Portals;Motion pictures;Electronic commerce;Adaptation models;Representation learning;Big Five;e-commerce;personality;RNN;user modeling;user representation learning},
  doi={10.1109/ACCESS.2022.3220781},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10020705,
  author={Paulraj, Prince and Hall, Elijah and Armenta, Ana and Austin, Mark},
  booktitle={2022 IEEE International Conference on Big Data (Big Data)}, 
  title={Posteriori Trust: Behavior Driven Trust on a Network Graph at Scale}, 
  year={2022},
  volume={},
  number={},
  pages={3969-3974},
  abstract={Mobile networks can connect everyone with a simple call or message and recent years have seen a dramatic increase in abuse through robocalling and messaging. This impacts everything from network optimization decisions to users being scammed. Users on any network often believe that there should be some level of intelligence that allows for the blocking and detection of abuse like robocalling, telemarketing, or scam/fraud schemes. A key failure in most approaches is the desire to maintain user privacy while collecting this kind of intelligence. We have designed a way to determine trust between two devices in a way that is driven by device behavior and not intrusive through surveys or requiring access to private contact lists. Instead, we observe encrypted network traffic to build a weighted graph by taking all traffic as inputs to create a weighted vector which in turn considers all other traffic on the network and scales to a single numeric representation of trust. This gets us to a weighted trusted graph that can be the foundation to many other important business use cases including fraud prevention, marketing, and churn. After exploring our trusted graph, a form of social graph with trusted weights, we found that our graph is hyper connected through hub nodes that have very high outdegree counts, many relationships. In other social graphs this might be referred to as influencers, but when we add the concept of trusted relationships, these might be unwanted influencers. We show that by setting the right trusted threshold, we can filter out ~80% of the relationships in our graph without losing the core social structures, suggesting that a potential super-majority of relationships are untrusted.},
  keywords={Privacy;Telecommunication traffic;Big Data;Prediction algorithms;Data models;User experience;Fraud;weighted graph;mobile network;social graph;user targeting and segmentation;graph modeling in user understanding;behavioral user modeling},
  doi={10.1109/BigData55660.2022.10020705},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10967446,
  author={Mahmoudi, Mohsen and Taghiyareh, Fattaneh and Hessami, Farshad},
  booktitle={2025 29th International Computer Conference, Computer Society of Iran (CSICC)}, 
  title={Enhancing Learning Performance through LLM-Driven Adaptive Contents Based on Facial Engagement Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Recent advancements in AI have opened new avenues for personalized education, enabling learning environments to adapt to individual needs. This study explores the intersection of AI and Image Processing, mainly using facial emotion detection to monitor cognitive engagement and distraction during learning tasks. Previous research highlights the efficacy of emotion detection in identifying cognitive states and improving educational outcomes through personalized learning environments. Our primary goal is to evaluate how AI can adapt educational content in real time to enhance learning effectiveness based on emotional feedback. We utilized an LLM to develop educational content and identified moments of distraction or disengagement by monitoring learners' facial emotions while interacting with the system. Upon detecting distraction, the LLM dynamically restructures the content, subtly reintegrating it into subsequent materials without the learners' awareness. This method reinforces learning by presenting material in varied contexts, thereby improving learners' understanding. Our preliminary results indicate that this approach enhances comprehension levels in distracted learners. Furthermore, integrating emotion-based monitoring with LLMs may provide a responsive educational framework that adapts to learners' immediate needs, promoting deep cognitive engagement and a pleasant personalized learning experience. These findings suggest broader applications beyond academic learning, including professional training. It is the ambition of any learning system to be able to detect any attention fall and to have smart reactions without learners' awareness, which is the vision of our approach.},
  keywords={Training;Learning systems;Emotion recognition;Adaptive systems;Large language models;Predictive models;Chatbots;Generators;Real-time systems;Monitoring;Adaptive Learning;Emotional Feedback;Large Language Models (LLM);Personalized Education;User Modeling},
  doi={10.1109/CSICC65765.2025.10967446},
  ISSN={},
  month={Feb},}@ARTICLE{11420830,
  author={Araujo, Caio Felix de and Junior, Plinio Thomaz Aquino},
  journal={IEEE Transactions on Human-Machine Systems}, 
  title={Real-Time Identification of Personality Traits Based on User Navigation Behavior}, 
  year={2026},
  volume={56},
  number={2},
  pages={378-389},
  abstract={Understanding human behavior remains a paramount challenge for artificial intelligence in human–machine interaction. This study introduces an integrated approach for developing efficient and noninvasive adaptive systems tailored to digital environments. The method enables real-time inference of user intent by correlating personality traits with navigation patterns, improving processing accuracy, performance, and cost-efficiency. This research bridges the gap between user psychology and system design by incorporating integration variables, such as task completion time and dynamic interface adjustments. The results reveal significant correlations between psychological profiles and navigation behaviors, highlighting personality traits through user actions and decisions. Applications include personalized recommendation systems, online content curation, and adaptive support services. These findings contribute to the development of intelligent systems that address diverse challenges in digital environments, paving the way for adaptive human–machine systems aligned with individual needs and preferences.},
  keywords={Psychology;Navigation;Real-time systems;Digital systems;Usability;Data collection;Adaptive systems;Surveys;Human-machine systems;Decision making;Human–computer interaction;intelligent systems;personality-based user modeling;psychological modeling},
  doi={10.1109/THMS.2026.3663415},
  ISSN={2168-2305},
  month={April},}@INPROCEEDINGS{11199269,
  author={Dhote, Vijay and Mukhi, B. Suvarna and Lathigara, Amit and Srividya, Mudunuru and Khatkar, Monika and Raja, Mandapati},
  booktitle={2025 World Skills Conference on Universal Data Analytics and Sciences (WorldSUAS)}, 
  title={Wavelet-RSF Method for Multimodal Skin Lesion Analysis and Early Skin Cancer Diagnosis Using Deep Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={To maximize the reliability of recommendations in flexible and short-session settings, this study presents a new user sessions structure that capitalizes on machine learning. Predicting users’ successive behaviour over restricted durations, such online shopping browse or entertainment broadcasting, is the emphasis of the suggested approach, as opposed to static preferences frameworks. Integrating attention to oneself processes with session-based repeated neural network models (RNNs), the system uses a dual-layer design. It manages cold-start and information simplicity problems while capturing trends inside and across sessions as well as behavioural aspects that span sessions. Accurate modelling of interaction between items and users and transformations is further enhanced by the integration of graphing neural networks (GNNs). With the use of reinforcement education, the system becomes refined even more so it can respond instantly to input from users. Standardized discounting chronological gain (nDCG), clicked-through rate (CTR), and mean reciprocated rank (MRR) are all significantly improved in investigations run on Diginetica and Yoochoose, among other comparison datasets. The method outperformed conventional program-based foundations by 7.9 percentage points, reaching 93.62% session recommendations efficiency. The paying attention technique improves the suggested products’ environmental consistency and relevancy. For suggestions systems that operate in actual time or on portable devices, the suggested deep encounter design is ideal since it accurately records changing intention among users. In terms of overall productivity and precision, it outperforms both conventional and current neural networks.},
  keywords={Recurrent neural networks;Noise;Wavelet analysis;Feature extraction;Real-time systems;Graph neural networks;Discrete wavelet transforms;Lesions;Reliability;Skin cancer;Session-Based Recommendation;Deep Learning;Recurrent Neural Networks (RNN);Self-Attention;Graph Neural Networks (GNN);Real-Time Recommendation;Click-Through Rate (CTR);Cold-Start Problem;Reinforcement Learning;Temporal User Modeling},
  doi={10.1109/WorldSUAS66815.2025.11199269},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10895259,
  author={Mahmoudi, Mohsen and Taghiyareh, Fattaneh},
  booktitle={2024 31st National and 9th International Iranian Conference on Biomedical Engineering (ICBME)}, 
  title={Analysis Of Learning Confidence Using Multimodal Neurophysiological Data}, 
  year={2024},
  volume={},
  number={},
  pages={269-276},
  abstract={The advent of neurotechnology has opened new avenues for enhancing educational experiences by providing personalized feedback based on neural and behavioral data. Electroencephalography (EEG) is particularly promising for real-time monitoring of cognitive states, such as learning confidence, which can be pivotal for personalizing educational interventions. This paper aims to help learners recognize their cognitive states by providing real-time personalized feedback. We conducted an experiment involving 27 subjects, aged 18 to 40, who learned a foreign language online. Throughout the learning sessions, data were collected using EEG, eye-tracking, and mouse-tracking devices. EEG data were preprocessed to extract power spectral densities, mainly focusing on the alpha and beta frequency bands. Eye-tracker and mouse tracker data were analyzed to extract features such as fixation duration, saccade length, and interaction patterns. These multimodal data were used to train an ML model to predict learning confidence. Analysis revealed that the Pz location of the EEG sensor showed a significant difference (p-value $\lt 0.05$) in EEG power within the alpha and beta bands approximately 800 milliseconds before learners submitted their answers, correlating with their correct or incorrect answers. Eye-tracker and mouse tracker data provided additional insights into the learners’ engagement and decision-making processes. Our findings demonstrate the feasibility of using multimodal physiological data to model the accuracy of answers in real time. Upon success of this research, we would be able to provide learners with immediate feedback to ensure that all learning materials are comprehensively understood, leading to enhanced learning quality.},
  keywords={Biological system modeling;Gaze tracking;Predictive models;Brain modeling;Feature extraction;Electroencephalography;Real-time systems;Data models;Data mining;Context modeling;Personalized Feedback;Learning Confidence;User Modeling;neurophysiological;EEG;Eye-Tracker},
  doi={10.1109/ICBME64381.2024.10895259},
  ISSN={},
  month={Nov},}
