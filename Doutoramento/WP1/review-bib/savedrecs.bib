@article{ WOS:001639676500001,
Author = {Liu, Runxiong and Lin, Jiayin},
Title = {EqStruct-GNN: toward fair recommendation via debiased graph structure
   learning},
Journal = {INTERNATIONAL JOURNAL OF INTELLIGENT COMPUTING AND CYBERNETICS},
Year = {2026},
Volume = {19},
Number = {1},
Pages = {158-182},
Month = {FEB 16},
Abstract = {PurposeGraph neural networks (GNNs) have been widely applied to various
   recommendation scenarios due to their outstanding performance in
   capturing and modelling hidden relationships. However, as the
   performance of a GNN heavily relies on the graph structure, the
   structure bias can lead to significant unfairness problems in a
   GNN-based recommender system across different user groups. Furthermore,
   prior studies have shown that sensitive attributes of nodes can be
   revealed through the graph structure. In other words, even if a
   GNN-based recommendation system does not explicitly disclose a user's
   sensitive information, it can still be inferred from the imbalance in
   users' connections within the graph. This article therefore addresses
   the unfairness arising from such structural biases by proposing a novel
   model designed to mitigate these biases in GNN-based recommendation.
   Here, the fairness requirements refer to preventing the exposure of
   sensitive attributes during user modeling and avoiding biased
   recommendations across different demographic
   groups.Design/methodology/approachTo address this issue, we propose a
   novel fairness-aware graph neural network model, EqStruct-GNN, which
   aims to mitigate inter-group unfairness at the structural level. The
   model is composed of three key modules: (1) the Adaptive Behavior
   Modeling Module, which computes fairness-aware node behavior probability
   distributions; (2) the Fairness-Aware Structure Construction Module,
   which builds graph structures based on these distributions and (3) the
   Fair Representation Learning Module, which generates unbiased node
   embeddings. Together, these modules enable EqStruct-GNN to construct a
   fairness-aware graph that reduces structural bias and improves fairness
   across sensitive groups.FindingsExperimental results demonstrate that
   the proposed method achieves strong recommendation performance while
   ensuring fairness across multiple datasets. Furthermore, when applied to
   various backbone models, EqStruct-GNN not only significantly improves
   fairness metrics but also maintains or even enhances recommendation
   accuracy. These results highlight the generalization capability and
   practical effectiveness of the proposed
   framework.Originality/valueUnlike existing methods that focus on
   representation-level fairness, our model tackles structural bias at its
   root by building a fairness-aware debiased graph through a novel graph
   construction mechanism. This structure enables the learning of fair and
   high-quality node representations by effectively mitigating structural
   bias while preserving critical interaction information. In addition, the
   proposed approach is universally adaptable and can be seamlessly applied
   to various GNN architectures, demonstrating strong generality and
   practical applicability.},
DOI = {10.1108/IJICC-07-2025-0392},
EarlyAccessDate = {DEC 2025},
ISSN = {1756-378X},
EISSN = {1756-3798},
ResearcherID-Numbers = {Lin, Jiayin/JAO-3768-2023},
ORCID-Numbers = {Lin, Jiayin/0000-0001-9472-1981},
Unique-ID = {WOS:001639676500001},
}

@article{ WOS:001319594500017,
Author = {Portaz, Miguel and Corbi, Alberto and Casas-Ortiz, Alberto and Santos,
   Olga C.},
Title = {Exploring raw data transformations on inertial sensor data to model user
   expertise when learning psychomotor skills},
Journal = {USER MODELING AND USER-ADAPTED INTERACTION},
Year = {2024},
Volume = {34},
Number = {4, SI},
Pages = {1283-1325},
Month = {SEP},
Abstract = {This paper introduces a novel approach for leveraging inertial data to
   discern expertise levels in motor skill execution, specifically
   distinguishing between experts and beginners. By implementing inertial
   data transformation and fusion techniques, we conduct a comprehensive
   analysis of motor behaviour. Our approach goes beyond conventional
   assessments, providing nuanced insights into the underlying patterns of
   movement. Additionally, we explore the potential for utilising this
   data-driven methodology to aid novice practitioners in enhancing their
   performance. The findings showcase the efficacy of this approach in
   accurately identifying proficiency levels and lay the groundwork for
   personalised interventions to support skill refinement and mastery. This
   research contributes to the field of motor skill assessment and
   intervention strategies, with broad implications for sports training,
   physical rehabilitation, and performance optimisation across various
   domains.},
