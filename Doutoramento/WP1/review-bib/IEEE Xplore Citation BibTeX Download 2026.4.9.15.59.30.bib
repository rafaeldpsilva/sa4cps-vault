  booktitle={2025 IEEE 31th International Conference on Parallel and Distributed Systems (ICPADS)}, 
  title={Latent Interest Discovery and Cross-Level Interest Alignment for Multimodal Recommendation}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Multimodal recommendation aims to enhance user interest modeling by leveraging informative item multimodal contexts. Though existing GNN-based works have achieved notable success, they typically rely solely on the observed useritem interaction records, while ignoring suboptimal items that can reflect latent user interest. The inadequate records can lead to the insufficient modeling of user interest. Moreover, interest misalignment of cross levels is a prevalent challenge in accurate user modeling, while noisy modality features will further aggravate this problem. In this work, we propose a novel Latent Interest Discovery and Alignment Representation Learning Framework For Multimodal Recommendation (IDARec for short) to mine latent user interest and enhance interest alignment of cross levels via modality denoising. By utilizing rich mutlimodal features, we construct the potential user-item interaction graph and augment original one with it. To denoise modality features for better interest alignment, we adopt information bottleneck principles to extract the minimal and sufficient statistic. Extensive experiments are conducted on three real-world datasets, and the results demonstrate the effectiveness of IDARec.},
  keywords={Representation learning;Accuracy;Noise reduction;Feature extraction;Noise measurement;Data mining;Information theory;Context modeling;Multimodal Recommendation;Latent Interest Discovery;Cross-level Interest Alignment},
  doi={10.1109/ICPADS67057.2025.11323040},
  ISSN={2690-5965},
  month={Dec},}@INPROCEEDINGS{11245240,
  author={Xiao, Mengxuan and Li, Zhuo},
  booktitle={2025 IEEE International Symposium on Parallel and Distributed Processing with Applications (ISPA)}, 
  title={User-Interest-Driven Frame-Level Video Recreation with Enhanced Semantic Consistency}, 
  year={2025},
  volume={},
  number={},
  pages={1089-1094},
  abstract={In short video platforms, there is a growing demand for personalized video content from users. However, existing methods typically rely on shallow user modeling and focus only on recommending existing content, lacking the ability to actively create or modify video content to match interests, making it difficult to achieve content generation that is highly matched to the semantics of user interests. To address this problem, this paper proposes a user interest-driven video content recreation system, aiming to build an effective bridge between interest semantics and generative content. Firstly, user interest labels are embedded as high-dimensional semantic vectors using a pretrained language model, and they are fused to form a unified expression of interest through a multi-head attention mechanism. Subsequently, this interest vector is used to generate Prompts that control the stylistic and semantic changes of the video, thus enabling frame-level video recreation. To further improve the semantic consistency between generated content and user interests, this paper introduces the Contrastive Interest-Visual Alignment Optimization (CIVAO) algorithm based on comparative learning optimization algorithm to iteratively optimize the generated results so that the generated results are more closely aligned with the user's intention in the shared semantic space. The experimental results show that the method in this paper improves $\mathbf{1 0. 0 5 \%}$ in CLIP semantic matching and effectively achieves accurate interest-oriented video content recreation.},
  keywords={Bridges;Distributed processing;Attention mechanisms;Accuracy;Semantics;Contrastive learning;Vectors;Optimization;Videos;personalized video generation;AIGC;attention mechanism;contrastive learning;multi-modal semantic alignment},
  doi={10.1109/ISPA67752.2025.00149},
