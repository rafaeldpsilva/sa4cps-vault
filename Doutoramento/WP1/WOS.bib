@inproceedings{ WOS:000773858604016,
Author = {Valdes, Consuelo and Eastman, Diana and Grote, Casey and Thatte,
   Shantanu and Shaer, Orit and Mazalek, Ali and Ullmer, Brygg and Konkel,
   Miriam K.},
