@inproceedings{10.1145/3768421.3768501,
author = {Yuan, Zijian and Zhan, Simin and Zhang, Baohui},
title = {Interdisciplinary Knowledge Graph-Driven STEM Teacher Assistant Agent: Model Construction and Evaluation},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768501},
doi = {10.1145/3768421.3768501},
abstract = {Interdisciplinary learning has emerged as a key priority in China's ongoing education reform, yet STEM teachers often face major challenges including fragmented disciplinary knowledge, limited collaboration, and insufficient experience in interdisciplinary lesson design. This study introduces an AI-powered STEM teacher assistant agent, underpinned by a triadic synergy among frontline STEM teachers, an 86,542-node interdisciplinary knowledge graph, and the DeepSeek-R1-671B foundation model. Within the LangChain framework, the system orchestrates prompt-engineered tasks, applies Chain-of-Thought reasoning for stepwise inference, and employs graph-based retrieval-augmented generation (GraphRAG) to deliver explainable, curriculum-aligned support for interdisciplinary instructional design and knowledge integration. To evaluate system efficacy, we developed SciCurriculum-QA, a 226-item benchmark aligned with China's national curriculum. Using the RAGAS framework, the SciKG-RAG model demonstrated superior performance across four key metrics: Faithfulness (0.8064), Answer Relevancy (0.8785), Context Precision (0.9467), and Context Recall (0.8702). Controlled experiments further demonstrated clear advantages over vector-based baselines in multi-hop reasoning and alignment with China's national curriculum. A qualitative study involving 21 in-service teachers confirmed perceived gains in instructional confidence, cross-domain coherence, and classroom applicability. Overall, the study demonstrates the agent's potential to enhance teachers’ professional capacity for interdisciplinary teaching.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {477–482},
numpages = {6},
keywords = {Interdisciplinary knowledge graph, Pedagogical AI system, Retrieval-augmented generation (RAG), STEM teacher support agent},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768502,
author = {Liu, Xuejie and Wang, Rongrong and Song, Huiru},
title = {Research on the Application of Decision Tree Algorithm in Public Physical Education Practice Teaching},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768502},
doi = {10.1145/3768421.3768502},
abstract = {With the continuous expansion of public physical education practice teaching in higher education institutions, it has become imperative to explore data-driven methods for improving instructional effectiveness. Building on a review of current teaching models and data characteristics in university physical education, this paper proposes a design for a teaching-support system based on the decision tree algorithm. First, multidimensional data—including student fitness test scores, class participation records, and overall grades—are collected via surveys and learning-platform logs, and then preprocessed to handle missing and anomalous values. Next, a CART decision tree model is constructed and its split criteria and pruning parameters are optimized by cross-validation. Finally, the trained model is applied to real-world teaching interventions, delivering personalized training recommendations to different student groups. Experimental results show that this approach improves the accuracy of student performance prediction by 12.5\% compared to traditional statistical analyses, effectively supporting instructors’ decision-making and feedback in practice teaching. The study validates the feasibility and practicality of decision tree algorithms in university physical education and offers a reference for future research on intelligent PE instruction.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {483–490},
numpages = {8},
keywords = {Data preprocessing, Decision tree algorithm, Model optimization, Practice teaching, University public physical education},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768503,
author = {Wu, Hengzhi and Yuan, Junying and Deng, Haoran},
title = {Reorienting OOP Curriculum: From Knowledge-Centric Projects to Agentic AI-Driven Problem Solving},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768503},
doi = {10.1145/3768421.3768503},
abstract = {This study addresses limitations in traditional Problem-Based Learning (PBL) for object-oriented programming (OOP) education, which focuses on isolated programming knowledge and fails to personalize learning. We propose an AI-driven framework where students collaborate with Agentic AI to tackle authentic challenges. The AI assists by decomposing projects into Minimum Viable Solutions (MVS), co-designing personalized pathways, and providing real-time scaffolding. Results show students transition from syntax learners to system architects, deeply engaging with OOP principles like encapsulation and polymorphism. Teachers shift to design mentors while AI handles adaptive support. This synergy cultivates adaptable problem-solvers for evolving technological landscapes.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {491–496},
numpages = {6},
keywords = {Agentic AI-Driven, OOP Education, Problem-Based Learning},
