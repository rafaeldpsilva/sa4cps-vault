@inproceedings{10.1145/3768421.3768479,
author = {Fang, Yuan},
title = {Research on Digital Industrial Technology Empowering Collaborative Construction and Educational Management Innovation in Green Stadiums},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768479},
doi = {10.1145/3768421.3768479},
abstract = {Under the background of digital transformation and green development, digital industrial technologies have provided innovative pathways for the collaborative construction and educational management innovation of green sports stadiums. This paper focuses on the application of BIM, digital twins, the Internet of Things (IoT), artificial intelligence (AI), big data and other technologies in the construction of green sports stadiums. As discovered, the issues at present include low technology integration, imperfect collaborative mechanisms among stakeholders, imbalanced costs and benefits, and insufficient exploration of educational values. To address such issues, in this paper, the multi-stakeholder collaborative construction model involving government, enterprises, universities, and the public is proposed to define the roles of each stakeholder, build an information-sharing platform and achieve effective complementarity and sharing. Furthermore, it also explores innovative practices in sports education management to form a three-dimensional integration path of Technology - Scenario- Education, which builds an immersive ecological education system with technology empowerment, builds a practice platform for resource recycling education chains with scenario expansion, and promotes the transformation and upgrading of sports education management models with educational innovation. All such efforts provide support for the carbon neutrality goals of the sports industry and promote the sustainable development of green sports stadiums.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {339–346},
numpages = {8},
keywords = {Carbon neutrality, Collaborative construction, Digital industrial technologies, Educational management innovation, Green stadiums},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768480,
author = {Kang, Jihao and Liu, Chengyin},
title = {Construction and Evolutionary Analysis of Dynamic Event Logic Graphs for the Field of Ideological and Political Education},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768480},
doi = {10.1145/3768421.3768480},
abstract = {Addressing the challenge of inadequately mining the dynamic and correlational nature of event timelines within massive ideological and political education data, this paper proposes a method for constructing and analyzing a dynamic event logic graph for this domain, named the Temporal Event Graph Attention Network (TEGAT). This method fuses multi-source heterogeneous texts, identifies core event elements through natural language processing techniques, and constructs a dynamic event logic graph incorporating a temporal dimension to represent the sequential and causal relationships between events. Furthermore, this paper designs an evolutionary analysis algorithm based on a graph attention network and introduces the L2 norm of node embedding vectors as a proxy for event influence to quantitatively analyze the propagation paths and influence evolution of ideological and political hotspots. Experimental results on a self-constructed corpus in the ideological and political domain show that the proposed TEGAT model achieves an F1-score of 0.881 in event logic relation extraction, a 3.9\% improvement over the next-best model, and significantly reduces the error in the event influence prediction task. This research provides a new technical path and theoretical support for the quantitative analysis and intelligent decision-making in ideological and political education.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {347–352},
numpages = {6},
keywords = {Dynamic Evolution, Event Extraction, Event Logic Graph, Graph Attention Network, Ideological and Political Education},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768481,
