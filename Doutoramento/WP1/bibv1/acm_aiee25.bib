@inproceedings{10.1145/3768421.3768504,
author = {Xu, Ya and Zhang, Baohui},
title = {Structural Equation Modeling of AI Tool Use and Chinese Language Habits},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768504},
doi = {10.1145/3768421.3768504},
abstract = {With the rapid advancement of artificial intelligence, the widespread use of AI tools in English contexts has profoundly influenced students’ linguistic practices, particularly changes in native Chinese expression. However, existing studies often remain at the macro level or focus on single-variable analyses, leaving the underlying mechanisms underexplored. This study aims to investigate the relationships and mediating mechanisms among AI tool use intensity, language cognitive dependence, and language habit change. Based on 306 valid questionnaires from high school students, we employed an integrated framework combining Structural Equation Modeling (SEM) with machine learning methods. Specifically, beyond testing direct and mediated effects via SEM, linear regression and random forest algorithms were applied, with 5-fold cross-validation used to assess predictive performance. The results indicate that AI tool use intensity significantly promotes English-oriented shifts in Chinese language habits, with language cognitive dependence playing a partial mediating role, and notable group differences across proficiency levels. The main contribution of this study lies in constructing a “use intensity–cognitive dependence–language habit” explanatory framework and validating its predictive power with machine learning. These findings enrich empirical evidence for technology-mediated communication and second language acquisition theories while offering practical insights into balancing technological application and native language preservation.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {497–503},
numpages = {7},
keywords = {AI Tools, Language Cognitive Dependence, Language Habit Change, Random Forest, Structural Equation Modeling (SEM)},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768505,
author = {Chen, Siyi and Huo, Hanzhe},
title = {Human-Machine Differences in Adolescent Emotional Support: A Comparative Study of Responses Between a Real Mother and Four AI Language Models},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768505},
doi = {10.1145/3768421.3768505},
abstract = {This study compares emotional support for adolescents between four AI models (Doubao, Kimi, ChatGPT, Gemini) and a real mother through an AI interaction experiment designed upon real family conversation, focusing on emotional recognition accuracy and response types distribution. Responses are categorized into "emotional support," "educational guidance," "emotional damage," and "neutral" via conversation analysis and coding. Research shows that 1) both humans and AI misjudged indirect emotional intentions, linked to Chinese implicit communication; 2) Real mother shows frequent emotional damage responses, indicating a lack of emotional support in real adolescent families; 3) Foreign AI models (GPT-5, Gemini Flash) demonstrated relatively higher emotional support than domestic models. 4) Kimi exhibited authoritarian traits via excessive educational guidance (52\%) and unprompted help offers. The study provides key references for optimizing family communication and developing locally tailored AI emotional support tools.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {504–511},
numpages = {8},
keywords = {AI language models, Adolescent emotional support, Cross-cultural comparison, Parent-child communication, Response types},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768506,
author = {Guo, Xiaojun and Jiang, Wei and Niu, Yiifeng and Su, Shaojing and Zhang, Xianjian and Qiu, Xiaotian},
title = {Exploration of the Application of AI-Enabled O-PIRTAS Blended Teaching in the Unmanned System Countermeasures Series Courses},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768506},
doi = {10.1145/3768421.3768506},
abstract = {Blended learning has become a fundamental consensus in the field of education, with key research focuses including "Internet+" integration, student-centered pedagogy, and teacher efficacy enhancement. Teaching objectives serve as the cornerstone of talent cultivation, requiring strict adherence to Outcome-Based Education (OBE) principles. Curriculum development, program design, and instructional planning must holistically consider cognitive processes, knowledge dimensions, and thinking structures. Building upon this foundation, emphasis should be placed on contrastive concept learning (positive/negative examples) and learning communities, while leveraging the synergistic interplay of "research-teaching-mentorship" to strengthen foundational theory and cutting-edge technical training. The integration of "Internet+" and "AI+" technologies empowers modern pedagogy, and established models such as O-PIRTAS (Objective-Preparation-Instructional -video-Review-Test-Activity-Summary) can be employed to construct a closed-loop "Learn-Practice-Apply-Reflect" instructional framework. This approach enables personalized teaching and continuous pedagogical improvement. This paper examines the application of O-PIRTAS-based blended learning in anti-jamming communication techniques within unmanned system countermeasure courses, providing a reference for cultivating next-generation talent in unmanned warfare under emerging operational domains.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {512–517},
numpages = {6},
keywords = {AI-enabled education, Blended learning, Learning community, O-PIRTAS, Talent cultivation in unmanned system countermeasures},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768507,
author = {Xin, Zhe},
title = {An Empirical Study on the Coupling Coordination between the Disciplinary Structure of Higher Education and the Industrial Structure in China},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768507},
doi = {10.1145/3768421.3768507},
abstract = {The coordinated development of education and industry is the core link for high-quality socio-economic development. This paper uses statistical data on China's higher education and industrial structure from 2013 to 2023 and employs a coupling coordination degree model to empirically analyze the coupling coordination relationship between the two. The results show that the overall coupling coordination degree fluctuates significantly, declining from high coordination in 2014 to severe imbalance in 2023, with the synergistic adaptability continuing to weaken. By discipline, agricultural sciences and the primary sector maintained stable coordination in the early stages but later fell into loose association due to lagging disciplinary adjustments; science and engineering disciplines and the secondary sector experienced rapid growth followed by oscillating adjustments and are currently in a dynamic adjustment phase; and humanities and social sciences disciplines and the tertiary sector exhibit oscillating fluctuations, with significant impact from industrial digitization. Research indicates that the core issues are the mismatch between university talent supply and industrial demand, as well as the absence of an industrial feedback mechanism. Based on this, the study proposes strategies such as establishing a dynamic adaptation mechanism between disciplines and industrial development, and deepening the industry-academia-research collaborative education system, to promote positive interaction and coordinated development between the two.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {518–523},
numpages = {6},
keywords = {Coupling coordination, Higher education, Industrial structure},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768508,
author = {Zhang, Jingjing and Zhang, Chunhui},
title = {Educational Financial Efficiency of Higher Vocational Colleges with Double High-level Plan in Beijing, Tianjin and Hebei},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768508},
doi = {10.1145/3768421.3768508},
abstract = {Based on the RAM-ML model, this paper calculates the input-output efficiency, regional differences and factor contribution of education finance of 24 higher vocational colleges in Beijing, Tianjin and Hebei from 2015 to 2024. The results show that: (1) The overall educational financial efficiency of the "Double High-level Plan" higher vocational colleges in Beijing, Tianjin and Hebei reached the best level, and Hebei was superior to Beijing and Tianjin. 8 colleges realized the rationalization of input-output. (2) The contribution of output factors of the double-high colleges in Beijing and Hebei is far greater than that of input factors, while the double-high colleges in Tianjin mainly rely on input factors. According to this, they are divided into two types of typical colleges and the colleges with large output contribution are ideal. (3) Beijing is a technological highland, but its scale is unstable. Tianjin has weak anti-risk ability and the most serious efficiency collapse; Hebei has a strong force in the later period and its scale is constantly optimized. (4) Higher vocational colleges in Beijing, Tianjin and Hebei are characterized by "remarkable technology drive, weak scale contribution and unbalanced input and output". TFP shows gradient differentiation, technological progress (TC) dominates TFP growth, while input-biased technology (IBTC) and output-biased technology (OBTC) continue to be unbalanced, and MATC monopole drives TC significantly.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {524–530},
numpages = {7},
keywords = {Education finance, Higher vocational education, Input-output efficiency, RAM-ML model},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768509,
author = {Ke, Nan and Sun, Qiao and Guo, Yunwei},
title = {Thinking on the experimental teaching in electronic information education empowered by Large Language Model},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768509},
doi = {10.1145/3768421.3768509},
abstract = {With the rapid advancement of artificial intelligence (AI), Large Language Models (LLMs) have garnered significant attention due to their robust content generation capabilities and user-friendly, practical interactive experiences. In the context of efficient education, LLMs are at the forefront of driving the evolution of digital and intelligent educational practices, facilitating the reduction of teaching burdens for educators while enhancing the quality and efficiency of instruction. First of all, this study discusses the application prospect of LLMs in supporting electronic information teaching, and shows that LLMs can play a greater role in enabling the teaching implementation link which is more specific and needs human-mechine collaboration. Then we use the problem-solving research method to analyze three key challenges inherent in electronic information experimental teaching within higher education institutions: the complexity of lesson preparation for instructors, the difficulties students face in comprehension, and the challenge of tailoring instruction to individual learning needs. In response to these identified issues, the paper proposes targeted strategies leveraging the comprehensive capabilities of LLMs to assist electronic information experimental teaching, thereby promoting improvements in both teaching quality and efficiency. Through the thinking and discussion of specific problems, it provides a new application idea for new artificial intelligence new technology enabling experimental classroom and improving teaching quality and efficiency.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {531–536},
numpages = {6},
keywords = {Digital education, Experimental teaching, LLM, Quality and efficiency improvement},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768510,
author = {Zuo, Haichun},
title = {AI-Driven Outcome-Based Education for Complex Problem-Solving: Technical Framework and Practical Exploration of Micro-Course Clusters},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768510},
doi = {10.1145/3768421.3768510},
abstract = {This paper proposes an AI-integrated Outcome-Based Education (OBE) framework that combines backward design with micro-course clusters to enhance complex problem-solving (CPS) competencies in higher education. The technical architecture integrates three core computer technologies: (1) Python-based system dynamics simulation algorithms for mapping interdisciplinary variables; (2) machine learning optimization using Scikit-learn to predict student CPS development trends; and (3) IoT edge computing via Arduino-Raspberry Pi communication for real-time project monitoring. A 18-week empirical study with 180 undergraduates validated the model: AI-driven real-time feedback loops improved CPS competency gains by 42\%, with 91\% of capstone projects meeting industry deployment standards.  This framework bridges academia-industry gaps in AI education through actionable technical design.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {537–544},
numpages = {8},
keywords = {AI education, OBE, complex problem-solving (CPS), micro-course clusters},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768511,
author = {Cai, Zhongxiang and Ji, Bingyu and Pan, Yun},
title = {Analysis of the Dual Empowerment Pathways of AIGC Technology in the Teaching Reform of New Media Operations Courses},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768511},
doi = {10.1145/3768421.3768511},
abstract = {With the rapid development of Artificial Intelligence Generated Content technology, the field of education is undergoing unprecedented changes, which also provides a dual empowerment path for the teaching reform of new media operation courses. This paper systematically discusses the innovative application of AIGC technology in teaching practice in view of the current practical difficulties such as lagging curriculum system, weak practice scene and insufficient application depth of technical tools. Based on the specific cases of large language model, image generation tools and video generation platform, this paper constructs a two-way driving framework of "technology empowerment teaching innovation" and "quality-oriented ability reconstruction". It is expected that AIGC technology can realize the iteration of teaching content and the innovation of teaching methods through the functions of text generation and multi-modal creation, and improve students' creative thinking stimulation, systematic thinking construction and human-computer collaboration ability. This study provides a theoretical reference and practical framework for the intelligent transformation of new media operation courses in colleges and universities and the cultivation of new media talents in the AIGC era.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {545–552},
numpages = {8},
keywords = {Artificial Intelligence Generated Content, Human-machine Collaboration, New Media Operation, Reform in Education},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768512,
author = {Li, Yuan and Cai, Zhongxiang and Hua, Ming and Zhao, Li},
title = {The Practice of Blended Teaching Reform of University Information Technology Course Based on Intelligent Teaching Platform},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768512},
doi = {10.1145/3768421.3768512},
abstract = {To address the issues of differentiated learning among students, the disconnection between teaching content and professional demands in university information technology courses, this study constructed a blended teaching system based on an intelligent teaching platform. By reconstructing the course knowledge system, reforming teaching methods, designing a diversified evaluation mechanism, and relying on the Chaoxing Xuexitong Platform to achieve dynamic management of the teaching process, the final exam scores of the experimental class students increased by 3.99 points compared to the control class, the knowledge mastery rate rose to 89\%, and the classroom participation rate reached 100\%. This model effectively realizes the coordinated development of differentiated teaching and professional ability cultivation, providing a systematic solution for the reform of information technology courses in colleges and universities.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {553–559},
numpages = {7},
keywords = {Blended teaching, Intelligent teaching platform, Reform in education, University information technology course},
location = {
