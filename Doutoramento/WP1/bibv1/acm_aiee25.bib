@inproceedings{10.1145/3768421.3768453,
author = {Yao, Anshou and Zhang, Haidong and Yun, Xiangyun},
title = {Research on the Spatial-Temporal Characteristics and Influencing Factors of the Coupling and Coordination Level between High-Quality Education Development and Common Prosperity in Ethnic Minority Areas},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768453},
doi = {10.1145/3768421.3768453},
abstract = {The high-quality development of education in ethnic regions is the only way for China to achieve common prosperity. This article uses Dagum Gini coefficient method, spatial Moran index, and panel data modeling to explore the development of coupling coordination level between the two. The spatial evolution and influencing factors of the coupling and coordination of high-quality education development and common prosperity in 3 districts and 2 counties of Panzhihua City from 2023 to 2024 were analyzed from the dimensions of resource guarantee, process quality, educational benefits, economic prosperity, degree of sharing, and differences. Research on the use of computer technology to process large amounts of data, accurately presenting: ① the spatiotemporal characteristics of improving the quality of high-quality education development; ② The influencing factors of improving the high-quality development level of education; ③ Measures to reduce regional disparities. Based on the research results, it is recommended to optimize the allocation of educational resources and build a digital collaborative platform relying on computer technology to improve the quality and level of education development in ethnic areas, promote the coordinated development of high-quality education and common prosperity, narrow the education gap in ethnic areas, and promote the coupling and coordinated development of the two.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {181–188},
numpages = {8},
keywords = {Common prosperity, Coupling coordination, High quality development of education},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768454,
author = {Yuan, Fahu and Yu, Weixing},
title = {An Interpretable, Multi-Source Learning Analytics Model for Medical Laboratory Skill Assessment: A Case Study in Gram Staining},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768454},
doi = {10.1145/3768421.3768454},
abstract = {Traditional assessment of medical laboratory skills often focuses on summative outcomes, overlooking the procedural errors that lead to failure. This limitation is particularly acute for high-stakes, technique-sensitive procedures like Gram staining. To address this gap, we propose an intelligent assessment model that leverages multi-dimensional process data for precise, automated skill evaluation. Our framework integrates pre-class learning data from a SPOC platform, in-class interaction data from Rain Classroom, and fine-grained operational data from a virtual simulation platform for Gram staining (N=325). We employ a Decision Tree algorithm to construct a classification model that predicts experimental success and reveals the critical factors influencing the outcome. The model achieved a classification accuracy of 0.83 and an F1-Score of 0.83. Interpretive analysis of the model revealed that decolorization time (sim_decolor_time) is the single most critical predictor of success, followed by smear thickness (smear_thickness) and pre-class knowledge mastery (spoc_score). The model successfully identified typical failure pathways, such as "inadequate theoretical knowledge leading to imprecise control of critical step durations." This study validates the feasibility of building an interpretable, intelligent assessment model by fusing multi-dimensional learning data. The resulting framework offers a more objective and diagnostically insightful alternative to traditional methods and provides a validated paradigm for data-driven, personalized medical laboratory education.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {189–194},
numpages = {6},
keywords = {Decision Tree, Educational Data Mining, Learning Analytics, Medical Education, Skill Assessment, Virtual Simulation},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768455,
author = {Zhang, Binglin},
title = {Research on a Teaching Quality Analysis Algorithm Integrating Random Forest and Neural Network},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768455},
doi = {10.1145/3768421.3768455},
abstract = {Harnessing the information technology in education, the easy and quick assessment of teaching quality has now started to be one of the most important factors in making instructions effective and educational reformist. This article presents a hybrid method, which consists of Random Forest and a deep neural network, to solve the difficulties of traditional single-model approaches of balancing accuracy and robustness when processing various teaching data. At the first phase of the proposed framework, data from a broad spectrum of sources are transformed into a teaching quality evaluation dataset through a process including the initiation of a multidimensional evaluation indicator system, data cleaning, missing value imputation, and feature engineering, apart from the process of grade records, classroom behavior logs and questionnaires responses to be used as the initial data. Subsequently, after the model is trained, the Feature Selector is executed in Random Forest and then the Deep Learner constitutes the Neural Network in the rest of the layers toward the output layer of the model, and the loss function is jointly optimized until the end. In the last phase of this study, a series of empirical experiments cover this model that demonstrates the effectiveness of the hybrid model over a range of performance indicators where it is able to leapfrog both single models in accuracy, recall, F1-score and AUC and uplift the accuracy and generalization of the teaching quality evaluation result. The data obtained from the research make it possible for university and K-12 teachers to make data-driven decisions. At the same time, the findings set forth the theoretical and practical framework for future integration of self-supervised learning and online incremental updates.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {195–203},
numpages = {9},
keywords = {Deep Neural Network, Feature Engineering, Hybrid Model, Random Forest, Teaching Quality Analysis},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768456,
author = {Sun, Zhongmiao and Pang, Xiaofang},
title = {Enhancing Career Decision-Making Self-Efficacy Through Blended Learning: An Integrated Course Design with Random Forest Regression Algorithm},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768456},
doi = {10.1145/3768421.3768456},
abstract = {This study presents a comprehensive blended learning design for a "Career Guidance" course integrated with Bandura's self-efficacy theory, supplemented by machine learning techniques to analyze factors influencing students’ career decision- making self-efficacy. Based on career development theories and constructivist principles, the course integrates online and face-to-face components. Using data from 525 college students across one semester, we employed a random forest regression model to identify key predictors of self-efficacy improvement. Results show significant post-course improvements in self-efficacy (pre-test M=3.21, SD= 0.87; post-test M=4.56, SD=0.62; t=18.43, p&lt;.001, d=1.12), with the random forest model achieving high predictive accuracy (R²=0.82). Key predictors included "mastery experiences" (feature importance=0.23) and "occupational information gathering" (feature importance=0.19). This study provides a replicable model for integrating self-efficacy theory, blended learning, and machine learning in career education.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {204–209},
numpages = {6},
keywords = {Career decision-making self-efficacy, blended learning, career education, machine learning, random forest regression},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768457,
author = {Li, Chenjie and Nian, Niannian and Zhang, Ziquan and Takenova, Zhyldyz},
title = {Path Analysis of University Teachers’ Digital Literacy Enhancement Based on Deep Learning: A Perspective of Sports and Arts Integration},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768457},
doi = {10.1145/3768421.3768457},
abstract = {This study constructs a university teachers’ digital literacy assessment and enhancement model based on deep learning technology, focusing on the digital literacy development paths in the context of sports and arts curriculum integration. By collecting digital literacy data from 450 university teachers and employing a hybrid model combining convolutional neural networks and recurrent neural networks for analysis, the study identifies key factors affecting teachers’ digital literacy improvement, constructs a multi-dimensional digital literacy evaluation system, designs personalized digital literacy enhancement paths, validates the effectiveness of deep learning models in teacher digital literacy assessment, and provides scientific evidence for university teachers’ professional development. The CNN-LSTM hybrid model achieved 87.3\% accuracy with F1 score of 0.859, successfully identifying five typical enhancement path patterns including gradual improvement (42.3\%), leap-forward improvement (23.7\%), and fluctuating improvement (18.9\%) paths.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {210–215},
numpages = {6},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768458,
author = {Li, Jiaxuan},
title = {Construction of Teaching Evaluation Model Based on Deep Learning: Mapping Mechanism from Behavioral Data to Capability Portrait},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768458},
doi = {10.1145/3768421.3768458},
abstract = {Traditional teaching evaluation has problems such as strong subjectivity and single dimension, which is difficult to fully reflect students' comprehensive ability. This paper proposes a teaching evaluation model based on deep learning, which realizes the accurate evaluation of students' abilities by constructing a mapping mechanism from behavioral data to ability portraits. The model first preprocesses and extracts features from the collected student behavior data, then uses the deep learning network to model it, and finally outputs the student's ability portrait. Experimental results show that the proposed model is better than the traditional method in terms of evaluation accuracy and comprehensiveness, and provides new ideas and methods for teaching evaluation.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {216–222},
numpages = {7},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768459,
author = {Tan, Yunsong},
title = {Research on Personalised Learning Resource Recommendation Method Based on Graph Convolution},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768459},
doi = {10.1145/3768421.3768459},
abstract = {With the rapid development of information technology and internet resources, online learning has gradually become an essential component of modern education. However, the explosive growth of learning resources has also led to issues such as knowledge drift and topic deviation. To address these challenges, personalized learning resource recommendation systems have emerged. In response to the problem of sparse learning data, this paper proposes a graph convolutional-based method for recommending learning resources. The approach begins by constructing a bipartite graph that connects students with learning resources and employs lightweight graph convolution operations to capture students' learning preferences and identify similar learning resources. Subsequently, through entity alignment techniques, the method matches the learning resources in the student-resource bipartite graph with corresponding entities in educational knowledge graphs. By integrating a graph convolution model enhanced with an attention mechanism, it explores the relationships among different types of learning resources, thereby further enhancing their representation capabilities. Ultimately, experimental results on the publicly available MOOCCube dataset demonstrate that this method outperforms traditional recommendation approaches in terms of recommendation effectiveness.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {223–227},
numpages = {5},
keywords = {Graph Convolution, Knowledge Graph, Personalised Learning Resources Recommendation},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768460,
author = {Han, Shuang},
title = {Research on the Intelligent Learning Path of University Computer Basic Courses from the Perspective of AI},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
