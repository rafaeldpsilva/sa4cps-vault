@inproceedings{10.1145/3768421.3768484,
author = {Liu, Naiyu},
title = {GDPR Constraints on AI-Generated Music: Privacy Protection Challenges in Training Data},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768484},
doi = {10.1145/3768421.3768484},
abstract = {With the rapid development of artificial intelligence music generation technology, its application in the creative industry has raised significant challenges to privacy compliance. This article focuses on the privacy compliance issues of AI music generation technology under the framework of the EU GDPR, revealing the uniqueness of this field that distinguishes it from traditional AI privacy research. Research has found that the emotional attributes and creative characteristics of music data subject it to more complex compliance requirements than conventional data, and existing anonymization technologies have significant deficiencies in protecting the privacy of music data. Through case comparison and analysis, this study proposes a novel combined scheme based on technologies such as federated learning and synthetic data generation to construct a multi-layer protection system. The solution can effectively address the special privacy risks of music data, and at the same time demonstrate the unique value of the data trust model in balancing artistic innovation and privacy protection. Compared with existing literature, this study systematically explores for the first time the privacy protection challenges in the specific AI application scenario of music generation, providing new ideas for compliance practices in the creative industry. Research indicates that the sustainable development of the AI music industry requires the establishment of a new governance framework that takes into account both technological innovation and legal regulation.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {368–372},
numpages = {5},
keywords = {AI music generation GDPR compliance, Data governance, Privacy protection},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768485,
author = {Han, Luyue and Zhou, Song and Luan, Chengjie and Ren, Xiaoli and Liu, Fengxiang},
title = {Optimization and Application of Civil Engineering Practice Teaching Mode Based on VR/AR Technology},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768485},
doi = {10.1145/3768421.3768485},
abstract = {Virtual Reality (VR) and Augmented Reality (AR) technologies are transforming engineering education, with particular promise for civil engineering practice teaching. This study introduces an innovative mixed reality platform that combines both VR and AR elements to create immersive learning experiences. Unlike previous approaches that typically use either VR or AR in isolation, our integrated system allows students to experience both fully virtual environments and enhanced real-world scenarios. Through a comprehensive 16-week experiment with civil engineering students, we found that this blended approach significantly improved learning outcomes. Students demonstrated enhanced 3D spatial understanding and hands-on capabilities, resulting in a 12.3\% higher course completion rate and 92.5\% student satisfaction. These measurable improvements confirm that thoughtfully integrated VR/AR technology can effectively address traditional teaching limitations in civil engineering education, offering a practical blueprint for similar educational reforms across technical disciplines.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {373–376},
numpages = {4},
keywords = {Augmented Reality, Civil Engineering, Practice Teaching, Teaching Optimization, Virtual Reality},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768486,
author = {Mei, Qi and Wan, Qiang and Lyu, Peng and Chen, Pingbo},
title = {A study on the influence of teacher autonomy support on students' preferences for courses: based on the perspectives of machine learning and Quasi-Experimental Designs},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768486},
doi = {10.1145/3768421.3768486},
abstract = {This study aims to explore the impact mechanism of teacher autonomy support on students' liking for courses, and attempts to combine machine learning methods with causal inference tools to provide a highly interpretable and rigorous analytical path for the education field. The research subjects are college students majoring in new media operation related courses, covering e-commerce, big data, and accounting, totaling 235 people. Firstly, based on a quasi experimental design, the Propensity Score Matching (PSM) method was applied to effectively control for potential confounding variables between teacher autonomy support and whether students like the course. A paired sample t-test was conducted after 1:1 matching, and the results showed significant differences (p&lt;0.01). The estimated Average Treatment Effect on the Treatment (ATT) was 0.477, verifying the positive effect of teacher autonomy support on improving students' liking for the course. Subsequently, the RandomForest model was used to classify and predict whether students liked the course. The test set results showed an accuracy of 0.8511, indicating that the overall classification accuracy of the model was high. On this basis, in order to improve the rigor of causal inference, the SHAP (Shapley Additive exPlans) method was used to explain the model. Combined with covariates such as teacher autonomy support, student gender, grade, and major category, it was found that teacher autonomy support is the most important feature that affects whether students like the course, and it has a significant positive effect. In summary, teachers' independent support in the context of new media and related professional education has a significant promoting effect on whether students like the curriculum, and can effectively enhance their learning enthusiasm and professional competence. Meanwhile, there are differences in the impact of different dimensions of self-directed support on students' responses. This study combines machine learning classification prediction and SHAP interpretability analysis to provide an innovative method for causal evaluation in education. It also emphasizes the core value of teacher support behavior in optimizing students' learning experience, which has important theoretical implications and practical significance.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {377–381},
numpages = {5},
keywords = {PSM, Quasi-Experimental Designs, RandomForest, SHAP, Teacher autonomy support},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768487,
author = {Zhang, Congyan and Wang, Xudong and Zhou, Changshun},
title = {AI Technology Empowering Teaching Innovation in Civil Engineering at Local Universities: Practical Exploration in the Concrete Structure Design Course},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768487},
doi = {10.1145/3768421.3768487},
abstract = {This paper addresses issues such as rigid teaching modes and singular evaluation systems in the teaching of Concrete Structure Design for civil engineering majors in local universities, exploring pathways for deep integration of artificial intelligence (AI) technology with course teaching. The study took 59 students from grade 2022 of civil engineering major at a local university as the research object, conducted a 17-week teaching practice, and compared their learning performance with 66 students from grade 2021. An interdisciplinary knowledge graph containing 14 core knowledge nodes was constructed. Based on AI technology, personalized learning was realized through the analysis of students' learning behaviors such as online learning time, homework completion, and in-class exercises. A closed-loop evaluation system consisting of "process-oriented assessment (40\%, including regular homework, in-class exercises, completion of task points, autonomous learning, etc.) + outcome-oriented assessment (60\%, knowledge point coverage ≥ 90\%)" was established, forming a complete AI-empowered teaching model of "resources-teaching-evaluation". Practice shows that this model significantly enhances students' knowledge application capabilities (average score of the experimental group is 72.2, while that of the control group is 68.6; the rate of first class performance increases from 10.2\% to 23.7\%) and learning enthusiasm (with an average online learning duration reaching 8.6 hours). This study provides a replicable practical paradigm for the digital transformation of engineering courses in local universities.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {382–390},
numpages = {9},
keywords = {artificial intelligence, concrete structure design, knowledge graph, local universities, teaching innovation},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768488,
author = {Tang, Min and Dong, Jirui and Cheng, Shanshan},
title = {Artificial Intelligence Enhanced Integration of Art Education and Cultural Tourism for Student Engagement Improvement through PLS-SEM and IPMA},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768488},
doi = {10.1145/3768421.3768488},
abstract = {This study examines the impact of integrating art education with cultural tourism through Artificial Intelligence (AI) applications, with a particular focus on how this integration influences student engagement. Data were collected from 243 undergraduate art students in China to support the analysis. Based on engagement theory, a conceptual framework was developed to investigate the contributions of behavioral, cognitive, and emotional engagement in shaping students’ willingness to participate in AI-enhanced cultural learning experiences. The core AI system is implemented using a feedforward neural network architecture, in which output values are computed by applying a nonlinear activation function to weighted inputs and bias terms. To assess the data, the research applied Partial Least Squares Structural Equation Modeling (PLS-SEM) and Importance–Performance Map Analysis (IPMA). Findings reveal that emotional engagement exerts the strongest influence on engagement intention, followed by cognitive and behavioral engagement with decreasing levels of impact. IPMA results further confirm that emotional engagement is the most critical dimension in terms of both importance and performance. These findings underscore the significance of AI-driven personalized cultural experiences and adaptive content delivery, demonstrating how neural networks can be effectively utilized to foster emotionally immersive learning environments in higher education.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {391–396},
numpages = {6},
keywords = {Art Education, Artificial Intelligence, Cultural Tourism, Student Engagement},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768489,
author = {Zhai, Guolin and Li, Sai},
title = {Research on a Moral Education Evaluation System for College Students Based on Cognitive Development Theory and DeepSeek},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768489},
doi = {10.1145/3768421.3768489},
abstract = {College moral education evaluation is a key component in enhancing the effectiveness of moral education work. However, the current evaluation system faces issues such as rigid evaluation dimensions, insufficient application of technology, and a disconnect from the cognitive development patterns of students. This paper draws on cognitive development theory as its theoretical foundation and integrates DeepSeek artificial intelligence technology to establish a dynamic, personalized, and scientifically sound evaluation system for college students' moral education. The study analyzes the current state and shortcomings of traditional moral education evaluation, clarifies the principles and framework for constructing the new system, designs evaluation indicators based on cognitive development stages, explores the application pathways of DeepSeek technology in data collection, analysis, and feedback. The feasibility and effectiveness of this system were verified through research using the YOLO11 model. The study aims to provide theoretical support and practical solutions for college moral education evaluation, promoting a shift from a “results-oriented” approach to a “process-oriented” and “development-oriented” approach, ultimately fostering the coordinated development of students' moral cognition and behavior.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {397–402},
numpages = {6},
keywords = {DeepSeek, YOLO11, cognitive development theory, evaluation, moral education},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768490,
