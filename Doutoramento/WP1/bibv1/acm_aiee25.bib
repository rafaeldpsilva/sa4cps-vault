doi = {10.1145/3768421.3768477},
abstract = {With AI's rapid growth in education, translation teaching faces challenges of low efficiency and subjectivity in manual grading. This paper proposes an AI-driven, teacher-oriented assessment method using a fine-tuned BART model, semantic similarity, attention-based error detection, and strategy alignment to evaluate semantic accuracy, fluency, and style, while enabling real-time, actionable feedback and teacher intervention. Experiments show improved scoring consistency, accuracy, style alignment, and error localization, reducing grading time and enhancing pedagogical value, offering an efficient, accurate, and adaptable tool for college English translation teaching.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {333–338},
