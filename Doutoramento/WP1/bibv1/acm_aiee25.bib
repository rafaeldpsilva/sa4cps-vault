@inproceedings{10.1145/3768421.3768499,
author = {Liao, Fei and Wu, Jiabei and Zhou, Chenxin},
title = {Exploring Public Perceptions of Generative AI in Education with BERTopic-based Topic Modelling and LLM-driven Sentiment Analysis},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768499},
doi = {10.1145/3768421.3768499},
abstract = {Generative AI, since 2022 when ChatGPT was released, has been widely used in education. While bringing tremendous benefits to teachers and students, it also poses numerous challenges. Exploring the public's opinions and sentiment towards Generative AI in education will greatly promote their integration. Weibo, as the most important social media in China, offers a wealth of data to analyze public attitudes and viewpoints. In this study, 17,799 weibo posts was crawled for topic modelling and sentiment analysis by using BERTopic algorithm and the Large Language Model DeepSeek respectively.  It's suggested that the public mainly focus on seven topics related with Generative AI in education, including AI-driven teaching innovation and digital transformation, applications of AI in academic research and the resulting changes in academic publishing, applications and experiences of AI in language education, risks, challenges of using GenAI in education and responses, feedback and complaints after using AI, the development of artificial intelligence major and related fields as well as the impact of AI on the job market and responses. Nearly half users embrace this new technology for its convenience, while some people demonstrate different attitudes. They worry such risks as the job loss, plagiarism, over-reliance and so on. At the end this study, several suggestions are put forward to tackle those negative sentiments to promote the the deep integration of Generative AI in education. Meanwhile, the limitation of this study was also proposed.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {464–470},
numpages = {7},
keywords = {Generative AI, Sentiment analysis, Topic modelling, Weibo, education},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768500,
author = {Di, Haolin and Li, Lixia},
title = {An Empirical Study on the Segmentation of Learning Characteristics about Higher Vocational Students Based on Learning Burnout},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768500},
doi = {10.1145/3768421.3768500},
abstract = {The problem of learning burnout among vocational college students cannot be ignored. Learning feature segmentation technology provides a foundation and reference for solving the problem of learning burnout and achieving large-scale personalized learning. In the form of a questionnaire survey, a certain vocational college was selected as the research sample, and 700 valid questionnaires were retrieved. Calculate the scores of 13 indicators in 4 dimensions, namely learning burnout performance, teacher-student relationship, occupational interest and internal sensory preference. The overall detection rate of burnout in the sample was 73.7\%, among which 24.3\% of the students were severely burnout, 49.4\% were moderately burnout, and 26.3\% were not burnout. Clustering technology analysis was conducted on 13 indicators to obtain 11 typical types, and based on this, 11 different teaching strategies were proposed.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
