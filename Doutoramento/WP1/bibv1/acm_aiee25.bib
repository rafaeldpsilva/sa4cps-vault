@inproceedings{10.1145/3768421.3768483,
author = {Li, Jiaxi and Zhang, Bobo and Chai, Bencheng},
title = {Application of Self-Sovereign Identity in the Higher Education Institutions},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768483},
doi = {10.1145/3768421.3768483},
abstract = {With the ongoing construction of digital campuses, achieving secure identity management, efficient data sharing, and seamless service collaboration in higher education institutions has become a significant research focus. This paper outlines the core concepts, key technologies, and operational models of Self-Sovereign Identity (SSI), and designs a practical system framework tailored for university services. It describes the roles and functionalities involved, showcases application scenarios such as identity authentication and cross-department collaboration, and analyzes its advantages. The study concludes that SSI presents valuable opportunities in higher education and anticipates its future developmental trajectory},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {364–367},
