@inproceedings{10.1145/3768421.3768482,
author = {Hu, Keyi and Gong, Wei},
title = {A Triad Evaluation Framework for Human vs. Machine Translation Quality in Museum Heritage Dissemination},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768482},
doi = {10.1145/3768421.3768482},
abstract = {With the rapid advancement of AI in language processing, this study investigates the optimal integration of human expertise and machine efficiency in museum translation. We propose a novel Cognitive-Linguistic-Cultural (CLC) evaluation framework to assess translation quality in cultural heritage contexts. Analyzing 20 texts from Hubei Provincial Museum, totaling 3156 Chinese characters, we compare human translations with outputs from Baidu Translate and DeepL across three dimensions: cognitive accuracy, linguistic fluency, and cultural adaptability. Our results demonstrate that while machine translation achieves faster processing time, human translation maintains superior performance in cultural sensitivity (98\% accuracy vs. about 90\% for MT) and contextual fluency when translating museum texts. The study contributes a hybrid translation workflow model that combines AI efficiency with human cultural expertise, offering practical solutions for multilingual heritage dissemination. This research aligns with current HCI trends in cultural computing and intelligent language processing systems, and it is suggested that HT should be combined with MT in the tourism translation field so as to render the museum heritage better and spread Chinese culture.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {358–363},
numpages = {6},
keywords = {human-machine collaboration, intelligent language processing, museum translation, human translation, machine translation},
location = {
},
series = {AIEE '25}
