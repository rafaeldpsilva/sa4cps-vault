}

@inproceedings{10.1145/3768421.3768491,
author = {Tang, Yuchen and Mohd Rashid, Mohamad Saiful Sazwan},
title = {Using Gagn\'{e}'s nine-stage teaching method to enhance the educational function of Traditional Chinese Medicine (TCM) games},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768491},
doi = {10.1145/3768421.3768491},
abstract = {Although Traditional Chinese Medicine (TCM) has faded from mainstream medicine, it still carries the spirit of Chinese culture and has a positive impact on modern science. However, its dissemination channels are limited and boring, and educational game design lacks cognitive principles, resulting in low knowledge acquisition and high forgetting rates, thus weakening the dissemination of TCM culture. This study combines Gagn\'{e}'s Nine-Stage Teaching Method with game design to develop a TCM-themed visual novel, "The Story of a Chinese Doctor," and designs it through case studies, expert interviews (n=4), and questionnaires (n=123). Set in an imaginary ancient China, the game allows players to learn TCM knowledge and traditional virtues through diagnosis and treatment, competition, and moral decision-making. The gameplay combines multiple-choice and single-choice questions. This study explores the design of TCM educational games based on Gagn\'{e}'s Nine-Stage Teaching Method to improve its educational functions, including knowledge acquisition and knowledge forgetting. Previous studies tended to focus on the research on the nine-stage teaching method that conforms to human cognitive steps, but did not explore the hidden knowledge repetition in the nine-stage teaching method. This method integrates the strengths of various educational psychology approaches and conforms to cognitive principles, providing comprehensive and clear guidance for game design and applicable to other knowledge domains. Game design based on Gagn\'{e}'s Nine-Stage Teaching Method can promote cultural dissemination and provide new insights for TCM education.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {409–419},
numpages = {11},
keywords = {Gagn\'{e}'s Nine-Stage Method, Simulated diagnosis, Traditional Chinese Medicine (TCM), educational games, gamified learning, serious games, teaching theory, visual novels},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768493,
author = {Li, Zhuoyue},
title = {Research on the Construction of Ability Portrait of Highly Skilled Talents Based on Knowledge Graph and AI Personalized Training Path Planning},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768493},
doi = {10.1145/3768421.3768493},
abstract = {As a national basic industry, the cultivation of high-skilled talents in the electric power industry is of great significance to guarantee the safety of power grids and promote technological innovation. Aiming at the problems of insufficient dynamic adaptability of high-skilled personnel's ability and job requirements in the digital transformation of the electric power industry, and the inefficiency of traditional training "one-size-fits-all", this study proposes a competency portrait construction method based on the fusion of multi-source data and an AI-driven personalized training path planning model. Firstly, structured and unstructured talent data are acquired through multi-source data acquisition and preprocessing methods, and cleaning and standardization are carried out to provide data support for subsequent modeling; secondly, combining with the job characteristics of highly qualified personnel in the electric power industry (e.g., new energy operation and maintenance and smart grid overhauling), the competency portrait model of highly skilled personnel in the electric power industry is constructed based on the knowledge mapping technology to realize the following Secondly, based on knowledge mapping technology, we build a competency portrait model of highly skilled talents in the electric power industry based on knowledge mapping technology to realize a three-dimensional competency portrait framework of "skill-knowledge-competency". Take the training team of a provincial power company as an example for experimental verification. The results show that the method can improve the matching degree of training content by 33\% and shorten the employee skill attainment cycle by 25\%, providing technical support for the accurate training of enterprise talents.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {420–425},
numpages = {6},
keywords = {competency profiling, deep learning, knowledge mapping, multi-source data, personalized training, reinforcement learning},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768494,
author = {Liu, Xiaohua and Sun, Ruxin and Shi, Yan},
title = {Construction and Practice of an AIoT Practical Course Based on Agile Teaching Methodology},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768494},
doi = {10.1145/3768421.3768494},
abstract = {Based on the CDIO (Conceive-Design-Implement-Operate) framework, this paper presents the development of an AIoT (Artificial Intelligence and Internet of Things) practical course tailored for undergraduate education. Under an agile teaching model, with students at the center and guided by the development and sustainable maintenance of AIoT projects, supported by comprehensive AI-powered assistance for both teaching and learning, we explore and implement innovative approaches to AIoT practical education in the new era. By adopting the agile teaching methodology, this work addresses the contradiction between limited instructional time and the scale of AIoT projects, overcoming constraints imposed by scalability laws, thereby bringing AIoT practical training closer to real-world project implementation. AI-assisted instruction is fully leveraged, and project designs are developed based on open-source large models such as DeepSeek. Throughout iterative project cycles, architectural logic is continuously optimized to enhance the scientific rigor and innovativeness of project design. Agile teaching is implemented with a focus on student development, integrating theory, technology, and practice in a parallel and rapidly reconfigurable manner, enabling multiple cycles of knowledge acquisition and skill enhancement. This approach fosters continuous improvement in students’ practical application abilities and innovative thinking.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {426–430},
numpages = {5},
keywords = {AIoT, CDIO, agile teaching model},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768495,
author = {Li, Ziyang and Zhang, Shiyi},
title = {Polarization Distribution: The Phased Regional Distribution Pattern of Artificial Intelligence Innovation Resources in Universities},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768495},
doi = {10.1145/3768421.3768495},
abstract = {This paper assesses the concentration of university innovation resources for artificial intelligence in China. Drawing on a thorough assessment and synthesis of relevant research data, a clear explanation of the concept of university innovation resource concentration is presented. Following that, an evaluation mechanism for analyzing university innovation resource concentration in artificial intelligence is rigorously designed. The use of the entropy-weighted strategy for order preference by similarity to ideal solution (entropy TOPSIS) method, along with robustness analysis, allows us to undertake rigorous empirical tests. The results indisputably show that the concentration of creative resources in artificial intelligence at Chinese universities is polarized, driven by a triple core and local aggregation. In light of these findings, this paper proposes that the state actively support the shift from the existing "polarization effect" observed in provinces with high concentration to a more desirable "spillover effect" of factor transfer. These proactive methods will successfully address the present resource distribution disparities as well as the relative underdevelopment of university innovation resources in the field of artificial intelligence.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {431–443},
numpages = {13},
keywords = {artificial intelligence, demand side of innovation resources, innovation resource concentration, supply side of innovation resources, through side of innovation resources},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768496,
author = {Cao, Ying and Zhou, Mingkuan},
title = {Empowering bilingual interpreters with AI tools in multi-lingual interpreting training: insights into AI-assisted interpreting training and assessment},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768496},
doi = {10.1145/3768421.3768496},
abstract = {Computer-aided interpreting training mode (CAI) has emerged as a new strategy that emphasizes the combined use of AI-assisted tools and human intelligence. However, this strategy has not been empirically proven to be effective in fostering their ability in completing multi-lingual interpreting tasks. Thus, this study examined CAI interpreting training mode in improving student interpreters’ ability in performing multi-lingual interpreting tasks and explored their perceptions about the effectiveness of multi-lingual interpreting training. This study used a comparative analysis and recruited 25 third-year undergraduates majoring in translation and interpreting as participants. Data on students’ multi-lingual/bilingual interpreting quality and their cognitive load during interpreting were collected through interpreting tests and a NASA-TLX test, while data on perceptions of their L3 language proficiency and skills were gathered via a questionnaire. The interpreting quality were assessed by adapting Han and Lu's rating scales [1] with the results subjected to statistical analysis via a paired sample t-test. The questionnaire responses were analyzed using descriptive statistics, with some quartile categorizations ranging from very negative to very positive. The effectiveness of the study could be seen from the improvement of the students’ abilities to deliver target language output in a higher level of fluency and language quality. In addition, the student's cognitive load in listening and memorizing is significantly reduced with the aid of AI tools comparing with traditional working mode. The CAI mode fostered positive student perceptions, particularly regarding the ease of interpreting process. Hence, this study implies that CAI multi-lingual interpreting training can be used to enhance student's bilingual interpreting skills, reduce their cognitive load and improve their L3 proficiency.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {444–451},
numpages = {8},
keywords = {AI-assisted teaching and education, Computer-aided interpreting, cognitive load in CAI, human-machine collaboration, multi-lingual interpreting},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768497,
author = {Sun, Yueyue},
title = {Research on the Construction of Dynamic Matching Matrix and Its Adaptation to Educational Scenarios from the Perspective of Cognitive Symbiosisc},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768497},
doi = {10.1145/3768421.3768497},
abstract = {With the deep penetration of artificial intelligence technology in the field of education, human-machine collaborative education models have gradually become a research hotspot. However, the inadequacy of technology application and educational scenario compatibility remains the core bottleneck restricting its development. Based on the theory of cognitive symbiosis, this article constructs a dynamic matching matrix as an intelligent decision-making model. By following the technical path of "dimension design-rule modeling-scenario validation", it achieves precise matching of three major mechanisms: coexistence of educational scene characteristics and knowledge network, dynamic transfer of control, and maintenance of emotional connections. Research shows that this matrix is compatible in liberal arts, science, and interdisciplinary educational scenarios, balancing technological possibilities with educational necessities, and providing a replicable technical paradigm for the deep integration of artificial intelligence and teaching and learning.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
