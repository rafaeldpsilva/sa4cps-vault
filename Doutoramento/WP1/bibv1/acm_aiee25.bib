doi = {10.1145/3768421.3768460},
abstract = {This paper focuses on the relevant research on the application of artificial intelligence (AI) technology in the teaching of basic computer courses in universities. Traditional learning platforms have problems such as poor resource integration and lack of personalized learning support. Based on this, an intelligent learning path architecture relying on AI has been constructed. The construction basis and functional characteristics of this architecture are elaborated, and practical strategies are proposed from the aspects of knowledge graph construction and intelligent resource recommendation. Verified by practical application, this path can effectively enhance learning efficiency and teaching quality, and can provide a reference for the teaching reform of basic computer courses in colleges and universities.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {228–234},
numpages = {7},
keywords = {Artificial intelligence, Basic computer courses in University, Intelligent learning path, Intelligent teaching, Learning framework},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768461,
author = {Wang, Xiaojun and Ju, Ming},
title = {Investigating the Impact of Blended Ideological-Political Teaching on College Students’ Professionalism via Linear Regression Analysis},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768461},
doi = {10.1145/3768421.3768461},
abstract = {Professionalism is a critical objective in vocational education and a central focus of ideological and political curriculum reform. This study investigates the impact of a constructively aligned blended teaching design that integrates ideological and political components into a vocational course. We conduct a quasi-experimental study using two parallel classes in a Cross-border E-commerce course, applying hybrid instruction with embedded value education only in the experimental group. To evaluate effectiveness, we apply statistical inference using paired t-tests. In parallel, we employ supervised learning through linear regression analysis, leveraging questionnaire scores, behavioral observations, and online learning activity data. Results show that the blended teaching approach significantly enhances students’ professionalism, especially in patriotic and business-oriented dimensions. Linear regression reveals a strong positive relationship between learning duration and final academic performance, with an R-squared value of 0.585 and p &lt; 0.01. Qualitative observations further indicate increased student engagement and alignment with targeted value constructs. This work demonstrates the potential of combining machine learning-based evaluation with pedagogical design to rigorously assess and optimize ideological and political instruction in blended learning environments.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {235–240},
numpages = {6},
keywords = {educational data mining, linear regression analysis, online and offline blended teaching, professionalism, quasi-experimental studies, supervised learning},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768462,
author = {Feng, Yihang},
title = {The Strategic Decision-making Logic of Education Entrepreneurs in Digital Transformation},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768462},
doi = {10.1145/3768421.3768462},
abstract = {Based on multiple case studies of 32 educational technology enterprises and in-depth interviews with 67 educational entrepreneurs, this study systematically reveals the formation mechanism and practice path of educational entrepreneurs' strategic decision-making logic in digital transformation, with a focus on the core role of computer technologies. It was found that the decision-making logic presents a dynamic chain of "environmental perception - cognitive filtering - resource integration - decision output", where computer technologies such as artificial intelligence (AI), big data, and blockchain act as critical enablers: AI algorithms optimize environmental perception accuracy by 38\% through real-time user behavior analysis; big data analytics enhance resource integration efficiency by 42\% via demand prediction models; blockchain ensures compliance in data sharing with a security coefficient of 0.92. The core of the decision-making logic is to balance "digital efficiency" (driven by computing technologies) and "educational value". By constructing three decision-making models of "demand anchoring - technology adaptation" (relying on machine learning for demand matching), "compliance based - incremental innovation" (supported by blockchain for data traceability), and "ecological collaboration - resource leverage" (powered by cloud computing for cross-organization resource pooling), the study verified how educational entrepreneurs cope with triple challenges through dynamic capability theory (perception/capture/reconstruction abilities empowered by computer technologies) and Effectuation Theory. Data shows that enterprises using AI-driven resource integration logic improve efficiency by 42\%; those adopting blockchain for compliance management reduce risk by 37\% compared to the industry average. The effectiveness of decision logic is significantly correlated with computer technology maturity (e.g., 58\% lower implementation cost with optimized AI adaptive learning algorithms), policy incentives, and user demand intensity. The study further emphasizes that educational entrepreneurs need to establish a computer technology-based dynamic monitoring mechanism (integrating real-time data from AI and big data) and reduce resource constraints through cloud-based asset-light cooperation.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {241–248},
numpages = {8},
keywords = {Digital transformation, Dynamic capability theory, Education entrepreneur, Effectuation Theory, Strategic decision logic},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768463,
author = {Wei, Sun},
title = {Research on teaching effect prediction and evaluation system of ideological and political courses combining artificial intelligence and big data technology},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768463},
doi = {10.1145/3768421.3768463},
abstract = {This study aims to develop an AI-driven big data system for predicting and evaluating the effectiveness of ideological and political education courses, thereby enhancing teaching quality and personalized learning experiences. The methodology integrates data collection and processing, feature extraction, and machine learning algorithms, utilizing models such as Support Vector Machines (SVM), Random Forests, and Deep Neural Networks (DNN) to conduct multi-dimensional analysis and prediction of student behavior data, classroom interaction records, and feedback information. The system performs real-time assessments of teaching outcomes through machine learning models and generates customized feedback reports. Research findings demonstrate that the system excels in improving prediction accuracy and real-time responsiveness, while demonstrating strong adaptability and scalability. It provides data-driven support for ideological and political education courses, offering practical solutions for educational innovation.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {249–252},
numpages = {4},
keywords = {artificial intelligence, big data, ideological and political course, teaching effect evaluation},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768464,
author = {Chen, Liuqiao and Huang, Yan and Jiang, Zhenglin and Chen, Ying},
title = {Generative Feedback for Code Learning: A Study on LLM-Driven Formative Assessment},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768464},
doi = {10.1145/3768421.3768464},
abstract = {This study investigates the integration of large language models (LLMs) into programming education, emphasizing their role in enhancing learning motivation, teaching efficiency, and formative feedback. On the student level, frequent LLM usage significantly improved learners' programming comprehension, self-regulation, and problem-solving willingness. On the instructor level, LLMs alleviated repetitive workloads, enabling teachers to shift their focus toward creative guidance and interdisciplinary design. Correlation analysis confirmed a strong positive relationship between LLM interaction frequency and student performance, affirming the pedagogical efficacy of AI assistance. A closed-loop mechanism was established, integrating students, teachers, and AI into a feedback ecosystem driven by student behavior, real-time model response, and adaptive instructional strategies. Through case studies, metric-based evaluation, and interactive logs, this research highlights the transformative potential of LLMs in building a dynamic, data-informed programming education framework.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {253–259},
numpages = {7},
keywords = {Generative Feedback, Intelligent Code Assistance, Large Language Models, Programming Education},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768465,
author = {Shao, Jinyang and Xu, Huazhen},
title = {RESEARCH on campus APP tourism intelligent report generation based on multimodal learning},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768465},
doi = {10.1145/3768421.3768465},
abstract = {Current campus apps generally suffer from a single functional architecture and lagging technological innovation, making it difficult to effectively implement campus tourism services and thus leaving university tourism resources unused. To enhance the user experience and functional integration of campus apps, this study proposes a method for intelligent travel report generation for campus apps based on multimodal learning and develops the MM-TravelReporter model. By building a unique campus tourism feature and integrating heterogeneous data from multiple sources, such as images, text, and location information, this study generates personalized travel reports with one click, providing a digital vehicle for the campus tourism functional architecture of campus apps. Based on a dataset of 12,500 campus images, 18,000 user texts, and 1,500 trajectories, experiments show that through the fusion of multimodal data, the generated travel reports have significantly improved in content richness (BLEU-4 increased to 0.342, ROUGE-L increased to 0.473), consistency between text and images (CLIPScore increased to 68.9) and cultural accuracy (Recall@3 reached 0.93, FER decreased to 0.054).In practical deployments, this feature increased campus exploration efficiency by 3.2 times, achieving an 87\% user recommendation rate This study provides valuable insights into the application of multimodal learning in the field of university tourism, contributing to the innovation of campus apps in the new era.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {260–265},
numpages = {6},
keywords = {LLM, Multimodal learning, Transformer, campus tourism},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768466,
author = {Lei, Zengqiang and Wu, Fangrong and Zhang, Jingyan and Feng, Haisheng},
title = {Federated Learning Data Processing Method Based on Knowledge Graph},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768466},
doi = {10.1145/3768421.3768466},
abstract = {In the era of big data, the demand for data decentralization and privacy protection has brought challenges to the training of deep learning models. This article proposes a knowledge graph based federated learning data processing method, which constructs structured data from different participants into a knowledge graph and achieves collaboration and sharing of the knowledge graph within the federated learning framework. This method does not require participants to directly exchange knowledge graphs, which can protect data privacy, solve problems such as data silos, poor data sharing and collaboration capabilities, and insufficient model generalization ability. By utilizing the knowledge graph of multiple participants, richer samples and a wider feature space can be obtained, thereby training a global model with better performance. The experimental results show that this method outperforms centralized training in model accuracy and has good application prospects.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {266–270},
numpages = {5},
keywords = {Artificial Intelligence, Federated Learning, Homomorphic Encryption, Knowledge Graph, Machine Learning},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768467,
author = {Zhou, Chuan},
title = {Algorithm Optimization and Implementation of Intelligent Scoring System for College English Translation},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768467},
doi = {10.1145/3768421.3768467},
abstract = {With the rapid development of artificial intelligence technology, intelligent scoring systems are increasingly widely applied in the educational field. To address issues in college English translation assessment such as strong subjectivity and inconsistent scoring standards, this paper proposes an intelligent scoring algorithm based on deep learning and natural language processing. By incorporating an improved BERT model and attention mechanism, combined with N-gram language models and word embedding technology, a multi-dimensional scoring framework is constructed. Experimental results demonstrate that the proposed algorithm outperforms traditional methods in terms of scoring accuracy, consistency, and efficiency, achieving a scoring accuracy of 92.3\% and a Pearson correlation coefficient of 0.89, significantly improving the objectivity and reliability of translation assessment.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {271–275},
numpages = {5},
keywords = {Algorithm Optimization, Deep Learning, Intelligent Scoring, Machine Translation Evaluation, Natural Language Processing},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768468,
author = {Liu, Pinjie and Zhan, Chun'E},
title = {Research on Visual Learning Platform for Database Principles Knowledge Points Integrating Knowledge Graph and Deep Learning},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768468},
doi = {10.1145/3768421.3768468},
abstract = {Database Principles courses challenge students with abstract, interconnected concepts that are difficult to master through traditional teaching methods. This study presents an intelligent visual learning platform integrating knowledge graph and deep learning to help students better understand these complex relationships. The platform constructs a knowledge graph containing 156 basic concepts and 89 core theories with 944 semantic associations, covering prerequisite dependencies, application relationships, and compositional structures. Using graph convolutional networks, we designed a personalized recommendation algorithm for precise modeling of learners’ cognitive states and intelligent learning path optimization. The visual interface employs hierarchical layout and interactive design to reduce cognitive load. Experiments with 180 undergraduate students showed significant improvements of 22.678\% in knowledge mastery, 19.6\% in learning efficiency, and 32.1\% in satisfaction compared to traditional methods, demonstrating the effectiveness of integrating knowledge graphs and deep learning in educational technology.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {276–280},
numpages = {5},
keywords = {Knowledge Graph, Graph Convolutional Network, Database Principles, Intelligent Recommendation, Educational Visualization},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768469,
author = {Chen, Zhaoyi},
title = {Dynamic decision-making algorithm for college students' full cycle career orientation: modeling of full cycle development and research on precise career orientation guidance path},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768469},
doi = {10.1145/3768421.3768469},
abstract = {This article focuses on the challenges of career development for college students and innovatively proposes a dynamic decision-making algorithm for college students' full cycle career orientation that integrates artificial intelligence algorithms. Against the backdrop of traditional career decision-making methods being difficult to accurately adapt to the complex and ever-changing development needs of college students, this algorithm leverages the powerful advantages of artificial intelligence algorithms to provide scientific and dynamic decision support for college students' career development. Artificial intelligence algorithms play a central role in it. On the one hand, using machine learning algorithms to deeply mine and analyze a large amount of career development data of college students, including multidimensional information such as academic performance, practical experience, and interest preferences, accurately identify key factors that affect career development, and construct personalized career development models. On the other hand, reinforcement learning algorithms are introduced to dynamically adjust decision-making strategies based on the behavioral feedback and career development goals of college students at different stages, achieving real-time optimization of decisions. In addition, natural language processing algorithms can intelligently screen and interpret massive amounts of career information, providing timely and accurate dynamic information on the job market for college students. By integrating artificial intelligence algorithms, this algorithm can comprehensively and accurately grasp the career development trajectory of college students, provide them with personalized career guidance decisions throughout the entire cycle from enrollment to employment, effectively enhance the scientificity and effectiveness of college students' career planning, and help them achieve high-quality employment and career development.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {281–286},
numpages = {6},
keywords = {Career development, decision algorithms, development cycle, dynamic data},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768470,
author = {Wang, Xiaohong and Zong, Shengchun and Zhang, Zongying},
title = {Empirical Optimization of Cross-Border E-Commerce Curriculum Using K-Means Learner Profiling and Random Forest Importance Ranking},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768470},
doi = {10.1145/3768421.3768470},
abstract = {Cross-border e-commerce programs must keep pace with fast-moving industry demands while serving heterogeneous learner needs. This study proposes a data-driven framework that couples learner segmentation with curriculum prioritization. A survey of 302 respondents was analyzed using K-Means, yielding three distinct profiles (n = 58, 93, 151) with moderate separation (silhouette = 0.56). To quantify drivers of perceived job readiness, a Random Forest classifier predicted curriculum-to-job fit with 82.5\% accuracy (precision 86.5\%, recall 94.2\%, F1 = 0.90). Feature-importance results consistently ranked career competency development and enterprise alignment as the top contributors, followed by instructor quality, overall satisfaction, and practical teaching; content-update speed showed comparatively lower influence. Course-level endorsements aligned with these findings: E-commerce Platform Operations and Cross-border E-commerce Fundamentals were most frequently selected, with Marketing \&amp; Promotion forming the next tier. Together, these quantitative results substantiate the study's central claim and motivate a layered curriculum design: a shared core anchored by the highest-leverage elements, complemented by targeted electives adapted to each learner profile. The framework offers a reproducible path for aligning cross-border e-commerce education with workforce expectations while accommodating learner diversity.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {287–292},
numpages = {6},
keywords = {Cross-Border e-Commerce, Curriculum System, K-Means clustering, Knowledge Graph, Professional Requirements},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768471,
author = {zeng, yan and li, du},
title = {Research on Teaching Reform of Film and Television Music Courses Based on Knowledge Graph},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768471},
doi = {10.1145/3768421.3768471},
abstract = {Film and television music, as a pivotal specialized course in the field of musicology, boasts significant academic value and practical significance. This course not only deeply analyzes the historical development, structural composition, and creative techniques of film and television music but also builds a bridge between music art and film art for students through detailed theoretical elaborations and case studies. In terms of teaching content, teachers not only systematically lecture on relevant concepts and theoretical foundations of film and television music but also emphasize the introduction and in-depth analysis of numerous classic film and television music works as teaching cases. This enables students to intuitively perceive how film and television music complements narrative visuals, enhancing emotional communication and atmosphere creation. At the same time, the course also pays special attention to the cultivation of practical skills, expanding the teaching of singing techniques for film and television songs, aiming to improve students' comprehensive artistic expression.Given the extensive content and complex knowledge points of the film and television music course, students often find it difficult to form a clear and systematic knowledge framework during the learning process. Therefore, from the perspective of teaching practice, this article proposes a design scheme for a knowledge graph of the film and television music course. The construction of this set of knowledge graph utilizes natural language processing technology to intelligently extract and organically integrate key elements such as core concepts, development processes, creative techniques, classic case analyses, and singing techniques of film and television music in a structured and semantic manner. This results in a comprehensive and systematic knowledge network diagram. This approach not only helps students better grasp the internal connections and logical hierarchies of the course content during the learning process but also effectively promotes the internalization and transferring of knowledge. This approach enables students to understand in better depth and flexibly apply the relevant knowledge of film and television music in the process of combining theory with practice, laying a solid foundation for future academic research and artistic creation.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {293–299},
numpages = {7},
keywords = {Course teaching, Film and television music, Knowledge graph},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768472,
author = {Zhou, Jinxuan},
title = {Teachers’ Digital Literacy in Computer Technology Integration: Comparative Insights, AI Implications, and Practical Implementation Pathways},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768472},
doi = {10.1145/3768421.3768472},
abstract = {The rapid advancement of digital technologies, particularly driven by artificial intelligence (AI), has made teacher digital literacy a key priority in global education reform. While much existing research focuses primarily on technical proficiency, this study adopts a broader perspective, investigating not only technical skills but also ethical awareness, pedagogical flexibility, and contextual barriers in AI integration. Using a comparative qualitative research design, the study incorporates semi-structured interviews with 26 teachers from central China, spanning urban (n=8) and rural (n=8) school teachers, university professors (n=5), and vocational school educators (n=5). These insights are juxtaposed with international research to identify transferable strategies and context-specific adaptations. The data were analyzed thematically and supplemented with case studies from both high-resource and low-resource schools. The findings reveal significant rural–urban disparities in AI access and proficiency, with rural teachers encountering substantial infrastructural limitations and heightened concerns about AI replacing human educators, while urban teachers highlighted challenges related to data privacy and algorithmic bias. University professors exhibited the highest level of AI literacy but expressed concerns regarding the integrity of AI-assisted assessments. The case studies emphasize that both high- and low-resource contexts can successfully integrate AI through tailored professional development and collaborative technology design. This study expands the conceptualization of teacher digital literacy in the AI era by incorporating ethical and identity dimensions and presents practical, equity-oriented pathways for educational policymakers and practitioners. The findings highlight the critical need for differentiated AI training, infrastructure investment, and teacher involvement in AI co-design to promote an inclusive and sustainable digital transformation in education.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {300–308},
numpages = {9},
keywords = {AI integration, Artificial intelligence in education, Teacher digital literacy, ethical issues, qualitative comparative study, rural–urban divide},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768473,
author = {Jiang, Xinyi and Liu, Xin},
title = {Research on AI-Empowered Models for Cultivating Students' Critical Thinking Skills},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768473},
doi = {10.1145/3768421.3768473},
abstract = {Cultivating students' critical thinking has become an important task in current education, but in actual teaching, there is still a lack of systematic cultivation paths. In response to this issue, this study has constructed a training model that takes the ability dimension as the core and integrates teaching links and technical support into a trinity. The ability dimension covers five aspects: analysis, reasoning, expression, evaluation and reflection, and has designed five teaching links: diagnosis, recommendation, monitoring, feedback and reflection. Through the human-machine collaboration mechanism, the guidance of teachers and the independent construction of students are organically combined. The research further proposed implementation strategies for the entire stage from teaching diagnosis to evaluation feedback, providing operational guidance for the implementation of the model. This model will subsequently undergo teaching empirical research to verify its feasibility. It is expected to enhance students' critical thinking abilities in multiple dimensions and provide referenceable ideas and methods for teaching practice.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {309–313},
numpages = {5},
keywords = {AI, Critical Thinking Skills, Cultivation mode, Human-machine collaboration},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768474,
author = {Qi, Xiangtao and Xu, Chao},
title = {Research on Ideological and Political Education Effect Evaluation Model Based on Multimodal Data Fusion and Attention Mechanism},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768474},
doi = {10.1145/3768421.3768474},
abstract = {In response to the core issues of strong subjectivity and single dimensionality in traditional evaluation methods for ideological and political education, this paper proposes an evaluation model based on multimodal data fusion and an attention mechanism, named the Multimodal Attention-based Ideological and Political Education Evaluation (MA-IEE). This model aims to achieve an objective and quantitative assessment of educational effectiveness by intelligently analyzing students' multimodal behavioral data (text, speech, vision) within an educational context, integrating deep learning with a cross-modal attention mechanism. In practical teaching applications, this model can serve as a formative assessment tool to provide teachers with immediate, fine-grained feedback on students' classroom reactions (such as emotional states) and learning engagement. This helps educators dynamically optimize teaching strategies, thereby connecting abstract educational goals with observable and analyzable student behavioral data, rather than being used merely for summative judgments. To verify the technical feasibility of the model, extensive comparative experiments and ablation studies were conducted on the publicly available multimodal emotion analysis datasets, CMU-MOSEI and IEMOCAP. The results indicate that the proposed MA-IEE model outperforms models based on single modalities and traditional fusion methods across key metrics such as accuracy, precision, recall, and F1-score, thus validating its effectiveness and superiority in fusing multimodal behavioral data for quantitative evaluation.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {314–319},
numpages = {6},
keywords = {Attention Mechanism, Deep Learning, Effect Evaluation, Ideological and Political Education, Multimodal Data Fusion},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768475,
author = {Xue, Yunlan and Wang, Weixing and Deng, Yuanfei},
title = {Multi-Agent Collaborative Intervention System Based on Reinforcement Learning Dynamic Path Planning in Lifelong Education},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768475},
doi = {10.1145/3768421.3768475},
abstract = {Dynamic path planning is a fundamental problem in lifelong education, where learners face heterogeneous resources, diverse learning paces, and evolving requirements. We propose the Multi-Agent Collaborative Intervention System (MACIS), a reinforcement learning–based framework that models educational factors and learner characteristics as interacting agents. By leveraging multi-agent collaboration, MACIS adaptively refines learning strategies, enabling autonomous discovery of efficient knowledge acquisition and skill development pathways. Theoretical analysis establishes convergence and optimality conditions, while extensive simulations demonstrate consistent improvements over baseline methods. Empirical results show that MACIS reduces average learning time by 2.5\% and enhances overall educational quality, validating its scalability and robustness in dynamic scenarios. These findings highlight the potential of multi-agent reinforcement learning to address knowledge inflation and system complexity in lifelong education, offering a principled and effective approach to intelligent educational systems.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {320–326},
numpages = {7},
keywords = {Dynamic path planning, Lifelong education, Multi-agent system, Reinforcement learning},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768476,
author = {Liao, Jinfeng},
title = {Machine Learning-Based Evaluation and Empirical Research on the Teaching Quality and Satisfaction of Online Course in Higher Education: A Case Study of College English Course},
year = {2025},
isbn = {9798400719905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768421.3768476},
doi = {10.1145/3768421.3768476},
abstract = {With the rapid development of online education, ensuring high-quality teaching has become a key concern for higher education institutions. Course teaching quality assessment is a crucial tool for monitoring teaching effectiveness and supporting continuous improvement. This study combines traditional evaluation system design with modern predictive analytics to provide a comprehensive teaching quality assessment method. First, a system and corresponding process for evaluating online distance education courses were established, covering indicators such as content quality, teaching methods, learning engagement, and platform usability. The system was applied to the "College English" course to verify its feasibility, scientificity, and practicality. Furthermore, to enhance objectivity and predictive power, a machine learning-based framework for predicting student course satisfaction was developed. Questionnaire data covering multiple dimensions of the learning experience was collected, preprocessed, and used to train classification models, including K-nearest neighbor (KNN), decision tree (DT), random forest (RF), and gradient boosting (GB). Model performance was evaluated using accuracy, precision, recall, and F1 score. Results show that KNN and random forest models achieve superior prediction accuracy and balanced classification. This integrated approach not only constructs a robust and operational online teaching quality assessment framework, but also demonstrates the potential of machine learning in providing data-driven insights for targeted improvements, providing a valuable reference for higher education course optimization and quality assurance.},
booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
pages = {327–332},
numpages = {6},
keywords = {Empirical Research, Evaluation, Machine Learning Models, Online Course},
location = {
},
series = {AIEE '25}
}

@inproceedings{10.1145/3768421.3768477,
author = {Li, Changyi and Long, Jiang and Sun, Shengen and Guan, Ning},
title = {An AI-Driven Teacher-Oriented Translation Assessment Method for College English Education},
year = {2025},
isbn = {9798400719905},
