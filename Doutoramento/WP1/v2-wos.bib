@inproceedings{ WOS:000454605200069,
Author = {Alhamid, Mohammed F. and Alsahli, Saad and Rawashdeh, Majdi and
   Alrashoud, Mubarak},
Book-Group-Author = {IEEE},
Title = {Detection and Visualization of Arabic Emotions on Social Emotion Map},
Booktitle = {2017 IEEE INTERNATIONAL SYMPOSIUM ON MULTIMEDIA (ISM)},
Series = {IEEE International Symposium on Multimedia-ISM},
Year = {2017},
Pages = {378-381},
Note = {19th IEEE International Symposium on Multimedia (ISM), Taichung, TAIWAN,
   DEC 11-13, 2017},
Organization = {IEEE; IEEE Comp Soc; Minist Educ; Asia Univ; Minist Sci \& Technol},
Abstract = {In the context of smart cities and Internet of Things (IoT), there are
   many trending contents on the social networks that reflect the picture
   of the community or their interest. In this paper, we propose a model
   that automatically collect trending social data and analyze them
   automatically. The model explores trending contents, overall attitude of
   textual contents and the relationships among the participated users. The
   analysis of the data collected involves the analysis of the user as well
   as the community in terms of interest, embedded tags, and the
   corresponding contents. The model is trained using data collected from
   Twitter, the famous growing social network, using hashtags, emoticons,
   geo-tags, and user profiles. We focus in this work on the Arabic
   contents to visualize the resulted emotions on a real world map.},
DOI = {10.1109/ISM.2017.76},
ISBN = {978-1-5386-2937-6},
ResearcherID-Numbers = {Alrashoud, Mubarak/ABD-1261-2020},
Unique-ID = {WOS:000454605200069},
}

@inproceedings{ WOS:001451119600031,
Author = {Abdelghany, Mo Adel and Stroulia, Eleni},
Editor = {Shirani, P and Salmani, K},
Title = {Augmented Reality Indoor-Outdoor Navigation through a Campus Digital
   Twin},
Booktitle = {2024 34TH INTERNATIONAL CONFERENCE ON COLLABORATIVE ADVANCES IN SOFTWARE
   AND COMPUTING, CASCON},
Year = {2024},
Pages = {275-280},
Note = {34th International Conference on Collaborative Advances in Software and
   Computing, Toronto, CANADA, NOV 11-13, 2024},
Organization = {York University},
Abstract = {Geolocated services can play a significant role in enhancing user
   experiences, in complex environments like complex campuses, for
   onboarding new employees and students and guiding tourists and visitors.
   This motivation is driving research and development in the area of
   geolocated augmented reality (AR) navigation but the field is still
   quite young. CampusGo is a software platform designed to provide a
   coherent suite of services to enable the development of AR-enabled,
   smart-campus applications, including (i) integration of a variety of
   multi-modal data about the campus, such as building architectural
   diagrams and 3D models of buildings, people's profiles, offices and
   labs, landmarks and events; (ii) indoor and outdoor path-planning
   services; (iii) real-time navigation support; and (iv) engaging web and
   mobile front ends. In this paper, we present the overall system
   architecture and describe our early experience with deploying and
   beta-testing CampusGo on a university campus.},
DOI = {10.1109/CASCON62161.2024.10838167},
ISBN = {979-8-3315-1562-1; 979-8-3315-0483-0},
ResearcherID-Numbers = {Stroulia, Eleni/H-6518-2018},
Unique-ID = {WOS:001451119600031},
}

@article{ WOS:000818696300001,
Author = {Vellei, Marika and Azar, Elie and Bandurski, Karol and Berger,
   Christiane and Carlucci, Salvatore and Dong, Bing and Favero, Matteo and
   Mahdavi, Ardeshir and Schweiker, Marcel},
Title = {Documenting occupant models for building performance simulation: a
   state-of-the-art},
Journal = {JOURNAL OF BUILDING PERFORMANCE SIMULATION},
Year = {2022},
Volume = {15},
Number = {5},
Pages = {634-655},
Month = {SEP 3},
Abstract = {The number of occupancy and occupant behaviour models developed for
   building performance simulation (BPS) has steadily increased for the
   past four decades. However, their use is still limited in practice. This
   is partly due to the difficulty in understanding their utility and to
   the challenges related to their implementation into BPS. Both problems
   can be attributed to the lack of a framework for their description and
   communication. In this paper, we fill this gap by introducing a
   framework to document occupant models, that represents the
   state-of-the-art of available information on the topic. The framework
   consists of four blocks (description, development, evaluation, and
   implementation) and can also be regarded as a guideline to help
   researchers communicate their models transparently. Based on a
   systematic review, we verify to which degree existing academic papers on
   occupant models meet the framework, thus providing a self-critical
   assessment of the state-of-the-art of occupant models' documentation.},
DOI = {10.1080/19401493.2022.2061050},
ISSN = {1940-1493},
EISSN = {1940-1507},
ResearcherID-Numbers = {Carlucci, Salvatore/AAA-5575-2020
