   Astrain Escola, Jose Javier/F-6418-2015
   Lopez Iturri, Peio/H-8681-2019},
ORCID-Numbers = {Falcone, Francisco/0000-0002-4911-9753
   AGHZOUT, Otman/0000-0001-9097-8069
   Picallo, Imanol/0000-0003-2109-4731
   Klaina, Hicham/0000-0001-7404-6413
   Vazquez Alejos, Ana/0000-0003-3426-2909
   Azpilicueta, Leyre/0000-0002-3821-0105
