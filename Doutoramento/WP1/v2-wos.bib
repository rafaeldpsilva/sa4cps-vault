@inproceedings{ WOS:000324371900146,
Author = {Batool, Rabia and Khan, Wajahat Ali and Hussain, Maqbool and Maqbool,
   Jahanzeb and Afzal, Muhammad and Lee, Sungyoung},
Editor = {Shen, CW and Kuo, SY and DalKwack, K and Chen, YW and Hsu, PY and Ko, F},
Title = {Towards Personalized Health Profiling in Social Network},
Booktitle = {2012 6TH INTERNATIONAL CONFERENCE ON NEW TRENDS IN INFORMATION SCIENCE,
   SERVICE SCIENCE AND DATA MINING (ISSDM2012)},
Year = {2012},
Pages = {760-765},
Note = {6th International Conference on New Trends in Information Science,
   Service Science and Data Mining (ISSDM), Taipei, TAIWAN, OCT 23-25, 2012},
Organization = {Inst Elect \& Elect Engineers (IEEE); Inst Elect \& Elect Engineers
   (IEEE), Taipei Sect; Inst Elect \& Elect Engineers (IEEE), Korea
   Council; AICIT; Natl Cent Univ},
Abstract = {E-Health industry is expanding considerably due to its effectiveness and
   efficiency in providing better healthcare services. The concern to get
   personalized information at one's doorstep is on the rise and social
   media is filling the gap by connecting users and sharing information.
   Personalized healthcare information in social media has become the
   cornerstone, allowing us to investigate innovative ways to effectively
   utilize its needs. The proposed approach discovers and uses personalized
   healthcare concepts by analyzing user posts on social networks. The
   analysis highlights the discrepancies in managing ones health and
   provides guidelines to overcome them. Methodology includes building user
   profile by identifying user related topics, emotions and health
   conditions. We investigated 6000 tweets for diabetic information
   however, our experimental data-set includes about 4000 tweets as we
   filtered out unwanted tweets. Smart Clinical Decision Support System
   (smart CDSS) service utilizes the results generated by our experiment.},
