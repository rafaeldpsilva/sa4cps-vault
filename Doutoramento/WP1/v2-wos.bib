   Naeem, Muhammad and Khan, Zahoor Ali and Qasim, Umar},
Editor = {Xhafa, F and Barolli, L and Snasel, V and Zelinka, I},
Title = {Comparative assessment of performance for home energy management
   controller in smart grid},
Booktitle = {2016 8TH INTERNATIONAL CONFERENCE ON INTELLIGENT NETWORKING AND
   COLLABORATIVE SYSTEMS (INCOS)},
