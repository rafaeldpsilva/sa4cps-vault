@inproceedings{10.1145/3747912.3747958,
author = {Li, Longshan and Wang, Lei},
title = {Prediction of Thermal Insulation Performance in Vacuum Glazing Using VMD-SSA-LSTM Hybrid Model},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747958},
doi = {10.1145/3747912.3747958},
abstract = {To address the challenges of nonlinearity, non-stationarity, and small sample size in predicting the thermal transmittance (U-value) of vacuum glazing, this study proposes a hybrid prediction model based on Variational Mode Decomposition (VMD), Sparrow Search Algorithm (SSA), and Long Short-Term Memory (LSTM) networks.First, Variational Mode Decomposition (VMD) adaptively decomposes the original temperature signals to extract multi-scale Intrinsic Mode Functions (IMFs), effectively suppressing noise while separating distinct heat transfer mechanism features. Second, the Sparrow Search Algorithm (SSA) globally optimizes key LSTM parameters—including hidden layer nodes, learning rate, and training epochs—to enhance the model's temporal feature extraction capability. Finally, a multi-component LSTM prediction framework is constructed, employing a weighted fusion strategy to generate high-precision prediction outputs.Experimental results show that the proposed VMD-SSA-LSTM model achieves superior performance with RMSE (0.3648), MAE (0.3429), and MAPE (1.2571\%), representing 81.2\%-86.3\% error reduction compared to the standalone LSTM model and 38.7\%-77.3\% improvement over the unoptimized VMD-LSTM approach. The model attains an average prediction accuracy of 98.74\% on test datasets, with errors consistently below 10\% in medium-to-low value ranges. Strong linear correlation between predicted and actual values across all test cases confirms the model's robustness and exceptional predictive capability.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {294–298},
numpages = {5},
keywords = {Long Short-Term Memory, Prediction of heat transfer coefficient of vacuum glass, Sparrow Search Algorithm, Variational Mode Decomposition},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747959,
author = {Hu, Guotao and Wang, Lei},
title = {Research on Heat Transfer Coefficient Prediction Model of Vacuum Glass Based on Attention Mechanism},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
