@inproceedings{10.1145/3747912.3747916,
author = {Chen, Hongyan and Xiao, Jian and Yao, Zhifang and Xiao, Zhengqi},
title = {Research on the Design and Efficacy Verification of Scientific Research Office Automation Processes Under the RPA-IPA Collaborative Architecture},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747916},
doi = {10.1145/3747912.3747916},
abstract = {With the improvement of the complexity of scientific research collaboration, the traditional OA scientific research office system faces the dual challenges of low efficiency and frequent human errors in the process of fund approval and ethical review. The purpose of this paper is to construct a collaborative architecture of RPA ( Robot Process Automation ) and IPA ( Intelligent Process Automation ), and to explore the efficiency optimization path of hyper-automation technology in scientific research office scenarios. By integrating process mining, dynamic rule engine and AI decision model, a three-tier framework covering process perception, automatic execution and intelligent optimization is designed. Taking the scientific research management system of the institute as an example, the operation data of manual process, traditional RPA and RPA-IPA collaborative mode are compared and analyzed. The experimental results show that the architecture significantly shortens the project approval process time, significantly reduces the error rate of reimbursement documents, and achieves 100 \% interface compatibility in the cross-system data synchronization scenario. The research confirms that RPA-IPA collaboration significantly improves the agility and reliability of the scientific research process through the dual mechanism of ' rule-driven + AI enhancement ', provides a reusable technical paradigm for the evolution of intelligent office systems, and also reveals the key influencing factors of human-machine collaboration boundary division.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {31–36},
numpages = {6},
keywords = {Ultra-automation, human-machine collaboration, intelligent process automation, process mining, robot process automation, scientific research office system},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747917,
author = {Li, Kaitong and Yang, Qinqin and Wang, Yichao and Xie, Jiayi and Xie, Zhizhuo and Peng, Feifei},
title = {Application Research on Artificial Intelligence-Empowered Library Service Model},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747917},
doi = {10.1145/3747912.3747917},
abstract = {Service model is the general way to deliver services. This study focuses on the library service model with AI empowerment. Through literature analysis, user demand investigations, and system development practices, this paper discusses the innovation and optimization strategy with AI technology for library service model. The traditional library service models are limited, and most of them are query and supply of book resources. With the development of technology and knowledge acquisition, the traditional library service model no longer meets the personalized retrieval needs and cross-domain retrieval needs. In recent years, some libraries have intelligent chat robots, but most of them can only answer some fixed questions instead of answering personalized questions such as books in a certain field. AI technology can significantly improve service efficiency and user experience through natural language processing, intelligent recommendation algorithm and cross-domain resource integration ability. This study designed and implemented an intelligent service system based on WeChat applet and Button Platform, including intelligent search, personalized recommendation, book review aggregation and other functional modules, which improved the library's current service model and solved the problems caused by limited service models.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {37–42},
numpages = {6},
keywords = {AI technology, Intelligent recommendation system, Library services, Natural language processing, Semantic interaction, User portrait},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747918,
author = {Chen, Tao and Chen, Xueyun and Fan, Guoshun and Lei, Zongyi and Xue, Shougui and Yu, Qi and Li, Fengzhen and Hu, Yufei},
title = {PIPENET Application of large-scale pipe network hydraulic condition simulation analysis},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747918},
doi = {10.1145/3747912.3747918},
abstract = {Traditional pipeline design methods determine pipe diameters based on flow rate and economic specific friction, which cannot accurately calculate fluid parameters at various points. When the pipeline scale is large, the calculation errors and workload are significant, leading to hydraulic imbalance in the pipeline and affecting pump selection. Flow regulation and balance for pipeline systems based on experience are also very challenging. However, using hydraulic calculation software like PIPENET for modeling and analysis can effectively avoid these issues. By simulating different operating conditions of the pipeline, the flow field can be accurately obtained. Adjustments such as changing pipe diameters or adding orifice plates can improve resistance distribution, optimizing pipeline design and pump selection. Additionally, it allows for precise calculation of the opening degree of each control valve to guide actual operations.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {43–48},
numpages = {6},
keywords = {Heating network, Hydraulic condition, Large-scale, PIPENET, Simulation},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747966,
author = {Zhu, Linkai and Zhu, Xiaolian and Liu, Lu and Yin, Bin and Li, Xiaojuan},
title = {From Regulation to Execution: Generating GDPR-Compliant Smart Contracts for Cross-Border Data Transfer},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
