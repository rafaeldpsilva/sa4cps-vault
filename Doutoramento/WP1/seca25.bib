doi = {10.1145/3747912.3747959},
abstract = {In order to overcome the limitations of the conventional methods for U-value measurement in vacuum glass, this work suggests deep learning models with attention mechanisms. The prediction capabilities of TabTransformer, FTTransformer, and TabNet were compared systematically. Following the hyperparameter optimization, the performance metrics on the test dataset were as follows: TabTransformer (MAE: 0.0649, MSE: 0.0056, R2: 0.9773), FTTransformer (MAE: 0.0530, MSE: 0.0036, R2: 0.9856), and TabNet (MAE: 0.0650, MSE: 0.0055, R2: 0.9779). All the models demonstrated good predictive capacity and stable feature detection, indicating their relevance and interpretability to thermal performance evaluation.},
