}

@inproceedings{10.1145/3747912.3747920,
author = {Zhao, Yushang and Peng, Yike and Li, Dannier and Yang, Yuxin and Zhou, Chengrui and Dong, Jing},
title = {Research on Personalized Financial Product Recommendation by Integrating Large Language Models and Graph Neural Networks},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747920},
doi = {10.1145/3747912.3747920},
abstract = {As fintech expands fast, the relevance of personalization of financial products recommendations has gained ground. Latent preferences and complicated relationships between users cannot be modelled with the traditional methods such as collaborative filtering or content-based models. Our hypothesis is a hybrid framework that combines large language models (LLMs) with graph neural networks (GNNs). A pre-trained LLM can embed text data (e.g., user reviews) into dense feature vectors, and a heterogeneous user -product graph can capture interactions and social connections. The GNN combines text and graph information by passing a custom message-passing mechanism that is jointly optimized. Our model achieves state-of-the-art results compared to standalone LLM or GNN on experiments run on public and real-world financial datasets, and is highly interpretable. The work provides two novelties in the direction of personalized financial advice and cross-modal fusion in recommender tasks in general.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {53–59},
numpages = {7},
keywords = {Financial Products, Graph Neural Network, Hybrid Model, Large Language Model, Personalized Recommendation},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747921,
author = {Liu, Yi and Pan, Mengyang},
title = {Research on safety hazard identification and risk warning of smart construction sites combined with large language model},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747921},
doi = {10.1145/3747912.3747921},
abstract = {With the acceleration of urbanization and the expansion of engineering construction, the safety management of construction sites faces unprecedented challenges. Traditional hidden danger identification and early warning methods have obvious shortcomings in response speed, recognition accuracy and multi- source information integration. Based on the background of smart construction site construction, this paper proposes a safety hazard identification and risk early warning system that integrates multimodal data and large language model (LLM), constructs a unified processing flow covering text, image and voice data, and designs a multi-channel neural architecture to achieve deep semantic parsing and risk classification. Through field deployment in two typical construction sites, high-rise residential buildings and underground municipal engineering, data collection and model training are completed, and compared with traditional rule methods. The results show that the proposed model is significantly superior to traditional methods in terms of hidden danger identification accuracy, early warning response time and multi-label risk understanding ability, providing a new path for smart building safety management.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {60–65},
numpages = {6},
keywords = {hidden danger identification, large language model, multimodal fusion, smart construction site},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747922,
author = {Yu, Zehao and Zang, Xiuhuan and Sun, Fuyong and Si, Jinxin and Gao, Shijie and He, Xin and Qu, Yangang},
title = {Integrated Graph Embedding and Path Inference for Traceability of Power Grid Fundamental Data Access},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747922},
doi = {10.1145/3747912.3747922},
abstract = {Data access traceability involves analyzing and tracking the access paths of data to identify data usage patterns and uncover potential issues. With the increasing complexity and scale of data access behaviors, traditional data access traceability methods face numerous challenges when dealing with large-scale and dynamically changing data access scenarios. These challenges include low traceability accuracy, low efficiency, and poor path interpretability.To address these issues, this paper proposes a novel approach for traceability of power grid fundamental data access by integrating graph embedding and path inference. Specifically, we construct a data access graph to capture the entities and relationships involved in data access. The graph embedding technique is employed to extract the structural and semantic information of the data access entities and relationships. Furthermore, path inference methods are combined to enhance the traceability of data access, thereby improving the interpretability of the traceability results.Experimental verification was conducted on simulated datasets, and the results showed that this method outperforms the comparison models Node2Vec-DRL, TransH, and RandomWalk in small, medium, and large-scale data access traceability graphs.Notably, the traceability accuracy remains above 90\% in small-scale data access graphs, indicating a significant improvement in both traceability accuracy and interpretability. Our proposed method provides valuable theoretical and practical insights for the traceability of power grid fundamental data access.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {66–70},
numpages = {5},
keywords = {Deep reinforcement learning, Path reasoning, graph embedding},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747923,
author = {Chen, Yun and Shen, Hao and Xie, Bangpeng and Wang, Jiayu and Zhao, Wenkai and Pan, Zhijun and Fu, Chaoran and Wang, Xiaohui and Liang, Xiao and Zhang, Zhonghao and Cai, Changyu},
title = {Knowledge Reasoning Chain-of-Thought Embedded Large Model for Power Text Writing},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747923},
doi = {10.1145/3747912.3747923},
abstract = {Although the current large language models (LLM) have very strong general capabilities, they lack professional knowledge of power systems and also do not possess the reasoning ability required to solve complex problems in the field of power systems. Therefore, we introduced a two-stage training method. Specifically, we first constructed and cleaned the Q&amp;A dataset of power professional knowledge. Based on these data, we fine-tuned the open-source large model to achieve the injection of power professional knowledge. Secondly, we constructed a power preference dataset based on the current most advanced closed-source LLM and expert experience, and used DPO to enable the open-source LLM to learn the expert thought chain in the field of power systems, improving the reasoning ability of the open-source LLM in the field of power systems.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {71–76},
numpages = {6},
keywords = {Direct Preference Optimization, Large Language Model, Power Industry},
location = {
},
series = {SECA '25}
}

