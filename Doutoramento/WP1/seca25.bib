@inproceedings{10.1145/3747912.3747960,
author = {Yuan, Jiajun and Qiao, Haotian and Luo, Shihan and Jiang, Chaozhe},
title = {Analysis of Pilot Workload during Low-Speed Flight Based on HRV Features},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747960},
doi = {10.1145/3747912.3747960},
abstract = {Low-speed flight is a condition near the critical stall speed, posing challenges such as reduced control surface effectiveness and possible airflow separation, which demands a higher pilot workload. Forty-six flight students participated in the experiment conducted on a desktop basic trainer equipped with Microsoft Flight Simulator 2020 using Polar Verity Sense sensors to collect physiological data. The HRVAnalysis toolkit extracted 30 HRV features from the raw data. After significance evaluation and feature selection using the random forest algorithm, five key features (max_hr, csi, sd2/sd1, vlf, and std_hr) were identified as significant and important. The results showed that low-speed flight imposes a higher workload on pilots with higher values of these HRV features. Four machine learning algorithms, Support Vector Machine (SVM), K-Nearest Neighbors (KNN), Random Forest (RF), and Logistic Regression (LR), were used to classify and predict workloads. The RF model outperformed the others with the highest accuracy and precision, effectively reducing false alarms and omission rates for complex tasks.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {304–307},
numpages = {4},
keywords = {HRV features, low-speed flight, machine learning, workload},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747961,
author = {Zhou, Yixuan},
title = {An urban traffic flow prediction method based on multi-source data fusion},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747961},
doi = {10.1145/3747912.3747961},
abstract = {Urban traffic congestion and the availability of multi-source data necessitate the fusion of heterogeneous traffic data to enhance prediction accuracy. This paper introduces the Multi-Graph Multi-Source Fusion Network (MG-MSFN), a novel method for urban traffic flow prediction. MG-MSFN integrates diverse data sources and constructs a multi-modal graph structure that incorporates static topology, dynamic traffic interactions, and semantic associations to capture complex spatial and temporal dependencies. To model complex spatial-temporal dependencies, the framework employs a spatio-temporal feature extraction module that combines graph convolutional net-work(GCN), temporal convolutional network(TCN), and self-attention mechanisms. An adaptive fusion layer integrates these perspectives, enabling the model to efficiently utilize key information from structured and unstructured data. Simulation experiments using the PEMS-BAY and GeoLife datasets show that MG-MSFN outperforms baseline models in key metrics, including mean absolute error (MAE), root mean square error (RMSE), and mean absolute percentage error (MAPE), demonstrating superior fitting and prediction accuracy.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {308–313},
numpages = {6},
keywords = {attention mechanism, graph convolutional network, multi-source data fusion, spatio-temporal feature decomposition, traffic flow prediction},
location = {
},
series = {SECA '25}
}

