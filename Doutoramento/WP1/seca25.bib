},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747951,
author = {Zhang, Jin},
title = {Deep Learning-Based Attribution Framework for Real-Time Budget Optimization in Cross-Channel Pharmaceutical Advertising: A Comparative Study of Traditional and Digital Channels},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747951},
doi = {10.1145/3747912.3747951},
abstract = {This article makes a case for real-time budget adjustments, which should be based on your ad's performance. Regarding customer journeys and their relation with different channels, regular marketing attribution models do not stand a chance, not in a strict regulatory context. In agreement with the current state of the art: explainable machine learning and multilingual sentiment analysis, the solution addresses the incoherent data (many such actions happen infrequently), the delayed conversions, and the global market diversity. In this post, we use multi-head attention bidirectional LSTM networks to quantify the credit that each marketing touchpoint receives, but also across digital and to the online touchpoints within traditional channels. By combining Federated Learning and SHAP interpretability, the framework provides compliance with privacy and transparency in model decision-making. Experiments demonstrate that the proposed framework achieves significant gains in attribution accuracy and resource allocation efficiency over baseline models. Furthermore, multilingual lessons in sentiment signals, coupled with conversion histories of users, provide insight into both when and to what extent one should be adaptively managing budget in response to market variation. In this post, we present a scalable, open, and transparent solution for pharmaceutical advertising COE managers to maximize the ROI of their promotions across this incredibly diverse group of markets.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {248–254},
numpages = {7},
keywords = {Cross-Channel Attribution, Deep Learning, Explainable AI, Pharmaceutical Advertising},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747952,
author = {Xie, Mingxi and Lin, Yuefeng and Wang, Yike},
title = {A Tree-Enhanced Multi-Agent Question Answering System for Enterprise-Specific Financial Knowledge Based on Dynamic Search},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747952},
doi = {10.1145/3747912.3747952},
abstract = {Question answering tasks in the financial futures are usually complex. It requires complex semantic parsing and dynamic optimization. To solve this issue, in this paper, we propose an enhanced question-answering system based on dynamic multi-agent search trees. In the system, we construct a hierarchical tree based on dynamic search using a multi-agent collaborative method. We integrated semantic association networks based on financial knowledge graphs. In this way, we automatically decomposed the complex queries. The key technical breakthroughs made in this paper include the following. Firstly, we build a task-planning algorithm based on multi-agent interaction. This enables dynamic expansion and pruning of search tree nodes, which manages the decomposition of domain-specific complex problems. Secondly, we established a financial knowledge graph with 150 core entities and 290 types of dynamic relationships. Using RDF triples and a semantic rule engine, it precisely expands domain terminologies and enhances cross-modal retrieval. Thirdly, we constructed a security-controlled automated framework design. This design uses a tool invocation-execution feedback loop and a hierarchical summarization mechanism (BM25 retrieval + context compression). In this way, it can reduce long-text processing time and ensure data permission control. According to the experiments, the system can answer specialized questions in different tasks, such as treasury futures trend analysis. It also supports fully automated reasoning and can be traced throughout the process. In this research, we provide an innovative solution for intelligent question-answering systems in financial futures. This method combines dynamic adaptability, domain expertise, and security reliability.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {255–260},
numpages = {6},
keywords = {Automated framework, Dynamic search tree, Financial knowledge graph, Intelligent question-answering system, Multi-agent collaboration},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747953,
author = {Zhan, Wangchen and Guo, Lejiang and Xu, Shijia and Li, Yubo},
title = {Research on UAV Target Detection Method Based on Improved YOLO Algorithm},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747953},
doi = {10.1145/3747912.3747953},
abstract = {Aiming at the problems of insufficient accuracy and model redundancy in the existing target detection algorithms for the task of identifying low - altitude small UAV targets, a UAV target detection method based on the improved YOLOv7 is proposed. By introducing the Convolutional Block Attention Module (CBAM), the expression of key features in the Feature Pyramid Network (FPN + PAN) is enhanced. The traditional convolution is replaced with depth - separable convolution to effectively reduce the computational complexity of the model, and the structure of the detection head is optimized. The model redundancy is reduced by streamlining the number of anchor boxes and using Ghost convolution. At the same time, the Angle - modulated optimization (ACIoU) is carried out on the loss function to improve the accuracy of bounding box regression. Experiments show that under the condition of a small parameter scale, the proposed method achieves a precision of 61.2\% and an mAP@0.5 of 52.0\%. The detection performance is significantly better than the original YOLOv7 and its derivative models, and it is suitable for real - time UAV target detection on edge devices.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {261–269},
numpages = {9},
keywords = {Separable Convolution, ACIoU, Yolov7, UAV Target Detection, CBAM, Depth},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747954,
author = {Zhu, Yuanbin and Liu, bin},
title = {YOLOv5 Traffic Sign Detection Incorporating Self-Attention Mechanisms},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747954},
doi = {10.1145/3747912.3747954},
abstract = {This paper presents an enhanced YOLOv5 model for traffic sign detection by integrating a dual-branch channel attention mechanism (global semantic + 3\texttimes{}3 convolutional local texture) and spatial attention. The channel attention module employs parallel pathways to jointly enhance color semantics (e.g., yellow warning signs) and texture details (e.g., triangular borders, arrow contours), while spatial attention refines spatial localization of signs. On the CCTSDB2021 dataset, the improved model achieves 98.0\% mAP@0.5 (+1.5\% vs. baseline), 97.0\% recall for warning signs (+3.5\%), and 92.3\% detection rate for small targets (pixel ratio &lt;0.1\%, +3.8\%). With a frame rate of 91 FPS, it maintains real-time performance while demonstrating robust detection in challenging scenarios, such as strong illumination, backlight, and rainy/foggy conditions. Experimental results validate that the dual-attention mechanism effectively suppresses background interference and improves feature discriminability for low-resolution and occluded signs.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {270–275},
numpages = {6},
keywords = {Attention mechanism, CBAM, Real-time detection, Traffic sign detection, YOLOv5},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747955,
author = {Zhou, Yaoyao and Wang, Lei},
title = {Prediction of Vacuum Glass Thermal Insulation Performance via Model Agnostic Meta Learning},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747955},
doi = {10.1145/3747912.3747955},
abstract = {To overcome the scarcity and homogeneity of data in predicting the thermal transmittance (U-value) of vacuum glazing, this study proposes a Model-Agnostic Meta-Learning–based multilayer perceptron (MAML-MLP). The model shares an initial set of parameters across multiple pseudo-tasks and employs a dual inner–outer loop optimization to achieve rapid adaptation under few-shot conditions. K-means clustering partitions the original samples into clusters, each treated as a pseudo-task that is further divided into support and query sets to meet MAML's training requirements. Experimental results show that MAML-MLP significantly outperforms a conventional MLP in MAE, MSE, MAPE, and R², confirming the method's effectiveness for limited-sample engineering predictions.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {276–280},
numpages = {5},
keywords = {MAML, meta-learning, multilayer perceptron, thermal transmittance prediction, vacuum glass},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747956,
author = {Yang, Jinxia and Wang, Lei},
title = {Comparative Analysis of U-Value Prediction Models for Vacuum Glazing Based on Optimization Algorithms},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747956},
doi = {10.1145/3747912.3747956},
abstract = {To solve the small sample size, big optimization space problem in the U-value prediction of vacuum glass manufacturing, this study broke the traditional idea and, for the first time, created a model characteristics-algorithm advantages dual-drive optimization framework. The article comparatively analyzed and contrasted the adaptability among DBO and PO ptimization algorithms, etc., on two general models (SVM/BP-AdaBoost). In sensitive high-dimensional conditions, the PO algorithm, based on its novel triple-behavior mechanism (random search + social learning + position adjustment), significantly improved the predicting accuracy of the BP-Adaboost model (RMSE = 0.0389, reduced by 52\% even compared with the benchmark PSO algorithm). In the parameter-sensitive SVM model, the DBO-optimized SVM model, taking advantage of the specificity of the dynamic balance mechanism, achieved improved training efficiency; the MAE between the model's predictive and actual U-values was less than 0.048. This study opened up the algorithm prospects for thermal performance prediction in vacuum glass. The test results proved that DBO is endowed with excellent parameter searching capacity in the SVM model, and the Parrot Optimization algorithm (PO) is endowed with good adaptability and stability for the integrated learning weight optimization task, again confirming that the aforementioned bionic intelligent algorithms still possess top performance in subtle environments like small samples and high titers.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {281–286},
numpages = {6},
keywords = {AdaBoost-BP, DBO, Heat Transfer Coefficient, PO, SVM, Vacuum Glass},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747957,
author = {Li, Zonglin},
title = {Research on the Influencing Factors of User Satisfaction Based on Online Reviews and Ratings of New Energy Vehicles},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
