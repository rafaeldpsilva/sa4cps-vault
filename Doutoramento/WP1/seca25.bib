}

@inproceedings{10.1145/3747912.3747945,
author = {Li, Anyu},
title = {Using Edge-Guided Cross-Modal Transformer for Infrared and Visible Light Image Fusion},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747945},
doi = {10.1145/3747912.3747945},
abstract = {The technology of infrared and visible light image fusion aims to extract and merge information from thermal imaging targets with the texture details of visible light images. However, existing fusion methods often neglect edge features and do not consider the differences in characteristics between different modalities, resulting in suboptimal fusion image quality. To address these issues, this paper proposes an edge-guided cross-modal Transformer fusion method, which utilizes edge operators to extract edge information from different modality images to enhance the texture information of the fused image. Additionally, the proposed cross-modal Transformer module leverages the long-range correlations of Transformers to model the interactions between features from different modalities, allowing the fused image to retain the texture and edge information from both modalities. Experimental results demonstrate that the proposed method performs excellently in both subjective and objective evaluations on public datasets.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {211–216},
numpages = {6},
keywords = {Infrared and visible light image fusion, cross-modal Transformer, deep learning, edge guidance},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747965,
author = {Li, Jiawei and Zhang, Qingyang and Zou, Hang and Liu, Jie and Lu, Hongyang},
title = {A Multi-Scale WRF–CFD Coupling method for High-Resolution Urban Wind Field Simulation in Shanghai Sea–Land Breeze Scenarios.},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747965},
doi = {10.1145/3747912.3747965},
abstract = {As coastal megacities expand seaward, interactions between urban form and mesoscale land–sea breezes (LSBs) grow more complex, critically affecting urban airflows. We present a high-resolution, multi-scale coupling of the Weather Research and Forecasting (WRF) model and a Computational Fluid Dynamics (CFD) solver—executed on a domestic high-performance computing platform —to simulate Shanghai’s wind-field evolution under LSB influence. A topography-aware inverse-distance-weighting interpolation reduces grid-exchange errors, boosting robustness. WRF captures diurnal mesoscale winds with high correlation (r = 0.824) and low mean absolute error (MAE = 0.71 m/s) at coastal sites, though inland microscale effects remain underresolved. To fill this gap, CFD runs over a 14 km² Bund subdomain reveal urban-morphology–driven heterogeneity and vortex formation: land breezes induce recirculation and pollutant stagnation, while sea breezes enhance ventilation yet raise shear and pedestrian-level hazard. Our results demonstrate the efficacy of WRF–CFD coupling for multiscale urban–atmosphere dynamics in coastal settings, offering actionable insights for wind-sensitive urban planning and adaptive climate design.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {217–224},
numpages = {8},
keywords = {WRF, CFD, Multiscale, Urban wind fields, Numerical simulation, Sea-land breeze, Parallel computing},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747947,
author = {Yu, Yibei and Zheng, Bo},
title = {The Mechanistic Study of Parkinson's Disease Subtypes Based on Deep Learning},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747947},
doi = {10.1145/3747912.3747947},
abstract = {Parkinson's disease is a neurodegenerative disease whose specific pathogenesis is still unclear, posing a major challenge for early diagnosis and precise treatment. The experimental data used in this study were derived from images of different subtypes of Parkinson's disease cells obtained from artificial stem cells by means of chemical induction and genetic mutation. The study used deep learning models such as MobileNet to classify various Parkinson's disease subtypes. Experimental results show that the MobileNet model achieves an average accuracy of 98\% in the disease subtype five classification task. MobileNet also shows good performance in distinguishing SNCAx3 mutants, PINK1 mutants and normal samples, with an average classification accuracy of 95\%. The experimental results of this study have an important reference value and application prospect for future medically assisted diagnosis of Parkinson's disease.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {225–230},
numpages = {6},
keywords = {MobileNet, PINK1, SNCA x3, deep learning, α-Syn},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747948,
author = {Liu, Wenming and Liang, Yong},
title = {AHP Hierarchical Analysis based Intelligent Jump Rope Design Research},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747948},
doi = {10.1145/3747912.3747948},
abstract = {Purpose Under the environment of the booming development of the smart wearable device market, smart jump rope as a product combining fitness and technology has attracted much attention. However, the smart jump rope handles in the current market lack comprehensive and scientific consideration of user needs during the design process, resulting in the product functions, experience and other aspects of the product failing to accurately meet the expectations of users. Methods The design entry point is explored through user requirements research, and the evaluation model and judgment matrix are constructed by combining the hierarchical analysis method (AHP) to quantify the weights of each design element. The focus is on how to optimize the design of the smart rope skipping handle based on scientific methods to achieve the best balance between functionality and user experience. Conclusion The application of hierarchical analysis can effectively reduce the interference of subjective factors in the design process and make the design process more systematic and scientific. This study significantly improves the safety, environmental adaptability and intelligent interaction ability of the product, which not only identifies the optimal solution, but also provides new research ideas and methodological references for industrial design and interaction innovation.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {231–237},
numpages = {7},
keywords = {hierarchical analysis, industrial design, intellectual products, smart jump rope, user requirements},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747949,
author = {Wu, Lisha and Chu, Jun and Xu, Jing and Ren, Yingjie and Lv, Xinxin and He, Longgang},
title = {Load-Balanced Optimization for Multi-Source Cross-Domain Computing Power Scheduling},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747949},
doi = {10.1145/3747912.3747949},
abstract = {In the context of the rapid development of information technology, the ability to deal with diverse tasks has become an important topic in system design. Under the circumstances of uneven distribution of computing resources and different link loads, how to efficiently deal with cross-domain tasks has become an urgent problem to be solved. We propose a multi-source cross-domain scheduling optimization strategy based on load balancing. By using dynamic task priority queue strategy, real-time demand and resource demand are considered comprehensively, priority division is used to ensure that high-priority tasks are processed in time, and resource utilization efficiency of low-priority tasks is optimized. In addition, a load balancing aggregation strategy based on graph neural network (GNN) is introduced to capture the relationship between nodes effectively through message passing mechanism, so as to realize intelligent task scheduling. Finally, we design a multi-task computing power scheduling strategy to improve the overall task processing efficiency through parallel processing. Experimental results show that the proposed method has excellent performance in improving system response speed and resource utilization.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {238–242},
numpages = {5},
keywords = {Cross-domain computing, Graph neural networks, Load balancing, Power scheduling},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747950,
author = {Zhang, Hui and Xu, Junsong and Zhang, Lan and Wanyan, Jianfei and Duan, Shikun},
title = {Spatio-temporal prediction model of urban waterlogging based on machine learning},
year = {2025},
