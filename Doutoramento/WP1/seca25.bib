}

@inproceedings{10.1145/3747912.3747937,
author = {Xue, Guanwen and Zhang, Ying},
title = {AMUVNet: an adaptive visual network model for underwater image enhancement},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747937},
doi = {10.1145/3747912.3747937},
abstract = {Underwater photography is an indispensable way of gaining knowledge regarding submerged scenes. However, these photos usually have problems with low clarity, bad contrast, and color distorting due to insufficient lighting, the nature of underwater environment, and the generally blurry nature of these kinds of pictures. These challenges have an extremely negative impact on underwater vision exercises. This paper suggests employing an adaptive multiscale visual network model, which is designated as AMUVNet to meet the needs. The model has a color correcting element that adapts to the scene features in compensating hues and improving visibility.Moreover, it integrates a multiscale residual block (MSRB) together with the so-called SepConv2d, which stands for deep learning architectures that operate on the image's channel and spatial levels of attention, enabling the capture of minute details. The overall quality of those images, as a result, is significantly improved.Besides this, an improved SEBlock module has been proposed, where max pooling is enhanced by combining max pooling with average pooling, and an attention mechanism is applied to strengthen the feature representation capability. The quality assessment metrics, compare the model's performance on fully referenced as well as non-referenced underwater images with the respective datasets, and indicate its superiority among the models used in the study.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {156–162},
numpages = {7},
keywords = {deep learning, image processing, neural networks, underwater image enhancement},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747938,
author = {Huang, Mingzhi and Huang, Chengling and Zhu, Yichen and Suo, Jiabao and Li, xiaojian},
title = {A feature selection algorithm in telecommunications fraud detection},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747938},
doi = {10.1145/3747912.3747938},
abstract = {Key challenges of fraud detection, particularly in optimal feature selection, are discussed thoroughly in this study. There are two main objectives: (1) establishing criteria to identify attributes with strong influence, and (2) developing an automated selection mechanism to enhance objectivity. To deal with those issues, a novel Feature Selection Algorithm (FSA) is proposed. In terms of Objective (1), to evaluate their effectiveness and analyze inter-feature correlations, the methodology evaluates variables and then systematically eliminates redundancies or low discrimination. As for Objective (2), pivotal transition points are identified by an innovative slope analysis technique to enable dynamic subset optimization. Using telecom industry datasets, based on empirical validation, feature sets curated by the FSA significantly improve detection model efficacy to make progress in both precision and operational efficiency.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {163–168},
