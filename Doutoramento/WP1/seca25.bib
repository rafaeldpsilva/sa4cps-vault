@inproceedings{10.1145/3747912.3747934,
author = {Liu, Xiaolong and Sun, Fuhui and Wang, Xiaoyan and Sun, Tanfeng},
title = {Violence behavior emotional weight assignment method for domestic violence case identification},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747934},
doi = {10.1145/3747912.3747934},
abstract = {Accurate identification of domestic violence cases is an important research direction in the legal field. With the development of text mining technology and natural language processing, the automatic identification of domestic violence cases using court indictments provides important basis for case adjudication. This paper proposes a BERT-based model that integrates violence behavior words and emotional evaluation words weight assignment (BERT-ViolenceEmo) for domestic violence case identification. By introducing violence words and emotional words to strengthen or weaken whether the text involves violence, the accuracy of case classification is improved. Based on the BERT (Bidirectional Encoder Representations from Transformers) model, the violence emotion analysis module identifies the emotional tendency and degree of violence in cases to construct a domestic violence case identification model. Using the CAIL2019 dataset, the model identifies whether divorce dispute cases involve domestic violence. Experimental results show that the BERT-ViolenceEmo model achieved 95.96\% accuracy, 86.54\% recall rate, and an F1 score of 0.9184, which are 4.5, 17.3, and 10.9 percentage points higher than using BERT model alone, demonstrating the significant effect of introducing violence behavior words and emotional words weights on improving model performance. This provides a new technical approach for intelligent identification of domestic violence cases.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {135–142},
numpages = {8},
keywords = {BERT, Case Identification, Domestic Violence Cases, Emotional Evaluation Words, Violence Behavior Words},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747935,
author = {Li, Gang and Ye, Guiyun and Xiao, Xinkai and Cheng, Zhe},
title = {Research on dynamic modification optimization of helical gear pairs with staggered shaft thickening},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747935},
doi = {10.1145/3747912.3747935},
abstract = {To improve the transmission characteristics of the staggered shaft variable thickness helical gear pair, this paper adopts two modification methods to modify the tooth profile of the variable thickness helical gear. The second method is to indicate the position of tooth profile trimming and the magnitude of tooth profile normal trimming on the gear meshing trajectory. By comparing these two modification methods, the second modification method theoretically provides a more convenient way to analyze the influence of variable thickness helical gear edge modification on meshing transmission. Then, 3D modeling and finite element simulation software were used to simulate and analyze the entity. The research results show that the modification scheme significantly increases the contact area and reduces contact stress and transmission error. Moreover, the contact state transitions from point contact to line contact, and the error fluctuations are more periodic.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {143–147},
numpages = {5},
keywords = {Simulation analysis, Tooth profile modification, Transmission error, Variable thickness helical gear},
