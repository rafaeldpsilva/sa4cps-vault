keywords = {Change points, Discriminative and Independence, Fraud detection, Telecommunications},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747939,
author = {Shen, Kunpeng and Yang, Wenlu},
title = {Kinect-based shoulder strength training recognition and correction},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747939},
doi = {10.1145/3747912.3747939},
abstract = {More and more people are opting to improve their physical fitness and develop the perfect body shape as a result of society's growing concern for health and form maintenance. However, improper motions during the real fitness process can easily reduce the benefits of exercise and even cause joint and muscle injuries, which might pose health problems. As a result, one of the key areas of modern scientific fitness study is how to precisely identify and rectify fitness movements using technical methods. This research proposes an efficient fitness action identification system based on the Kinect device's ability to collect human skeletal point data. First, using human kinematics theory, 17-dimensional distance and angle features are chosen to depict the shoulder training trajectory. This paper employs the Holt filter and Kalman filter, respectively, to smooth the movement trajectory and denoise the data in order to guarantee the correctness and stability of the experiment's data. After comparison, the Holt filter is more suited for processing the data in this paper. This research then trains LSTM (Long Short-Term Memory) and GRU (Gated Recurrent Unit) recurrent neural networks on the processed dataset and compares the results. According to the experimental data, the GRU-based model outperforms the LSTM-based model in terms of recognition accuracy, reaching 97.72\%.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {169–175},
numpages = {7},
keywords = {Data Denoising, Filter, GRU, Kinect, LSTM},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747940,
author = {Ma, Dekang and Shi, Fuli},
title = {Research on coverage-guided fuzzing technique based on Magma dataset},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747940},
doi = {10.1145/3747912.3747940},
abstract = {CGF (Cover-guided fuzzing) technique, as an important branch of fuzzing technique, has been widely used in the field of software vulnerability detection. In this paper, the core mechanism of CGF fuzzing technique is discussed in depth in the light of the general needs of software vulnerability detection, and two traditional fuzzing tools, Radamasa and Zzuf, are selected to conduct comparative experiments with the CGF equipped fuzzing tools, AFL and AFL-fast, on the Magma dataset. The results of the experiment show that the CGF tools’ vulnerability triggering efficiency is 28\% higher than that of Radamasa and Zzuf, and its vulnerability detection capability is 2.625 times higher than that of Radamasa and Zzuf. It also exposes the limitations of CGF tools, such as path dependency problem and seed scheduling problem. And the deficiencies of CGF technique in seed pool storage structure, seed variation strategy and bitmap storage method of edge coverage are analyzed for the above problems, which provides a reference for the optimization direction of CGF technique in the future.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {176–182},
numpages = {7},
keywords = {Coverage-guided fuzzing, Magma dataset, Software security, Vulnerability detection capability, Vulnerability triggering efficiency},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747941,
author = {Li, Qi and Quan, Fuyuan and Xu, Yan and Hu, Zhikui and Hu, Haolei and Chen, Xinxin and Zi, Kangli},
title = {Enhancing Structure-Aware Entity Alignment with SimAM and Recursive Self-Attention},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747941},
doi = {10.1145/3747912.3747941},
abstract = {Entity alignment (EA) aims to identify entities in different knowledge graphs (KGs) that refer to the same real-world object. While recent graph neural network (GNN)-based methods have achieved substantial progress, most approaches rely heavily on local structural information, thereby limiting their capacity to model long-range semantic dependencies. Additionally, the initial entity embeddings often suffer from insufficient discriminability, which further hampers alignment accuracy. To tackle these limitations, we propose a novel structure-aware entity alignment framework that integrates SimAM-driven embedding enhancement with a recursive generalized self-attention (RG-SA) mechanism. Specifically, the parameter-free SimAM module enhances the semantic discriminability of initial embeddings without introducing additional learnable parameters. On top of graph attention networks (GATs), the RG-SA module enables the joint modeling of both local structural context and global semantic interactions. A weighted fusion strategy is then applied to aggregate these complementary features into enriched entity representations. Extensive experiments on widely-used benchmark datasets demonstrate that our method consistently outperforms state-of-the-art baselines, confirming its effectiveness and strong generalization capability in structure-based entity alignment tasks.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {183–189},
numpages = {7},
keywords = {Entity alignment, Graph neural networks, Knowledge graph},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747942,
author = {Quan, Fuyuan and Li, Qi and Xu, Yan and Hu, Zhikui and Hu, Haolei and Chen, Xinxin and Zi, Kangli},
title = {PGD-RTE: Zero-Shot Document-level Relation Triplet Extraction via Guided Generation of Synthetic Data and Cross-Document Denoising in LLMs},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747942},
doi = {10.1145/3747912.3747942},
abstract = {Document-level Relation Triplet Extraction (DocRTE) aims to identify entities and their relationships in large text data. Traditional methods rely on large, manually labeled datasets, which are costly and time-consuming. Large Language Models (LLMs) can generate labeled data automatically, but data quality issues still exist in LLM-based approaches. To address this, we propose a Zero-shot Relation Triplet Extraction (ZeroRTE) framework—Prompt-guided Generation, Denoising, and Data-driven Relation Triplet Extraction (PGD-RTE). This framework uses LLMs to generate labeled data, applies denoising, and fine-tunes a Relation Triplet Extraction (RTE) model. It includes a Guided Generation Strategy Prompt (GGSP) to guide DeepSeek in generating labeled text and a cross-document knowledge denoising strategy using fine-grained consistency scoring to improve data quality. BERT is then fine-tuned on the denoised data. Experimental results show that PGD-RTE outperforms baseline models, achieving significant improvements in ZeroRTE tasks.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {190–197},
numpages = {8},
keywords = {Large Language Models, Relation Triplet Denoising, Relation Triplet Extraction, Synthetic Data, Zero-shot Learning},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747943,
author = {Liu, Jieliang and Le, Wu and Jia, Zhenhong and Tian, Jiahui},
title = {A detection method for surface defects on metal workpieces based on feature enhancement},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747943},
doi = {10.1145/3747912.3747943},
abstract = {Accurate detection of surface defects on metal workpieces is essential for industrial production. However, surface defects are diverse, small, and have fuzzy edges. Existing methods suffer from low detection rates and poor accuracy in detecting defects. Therefore, we propose a new model called ARF-YOLO based on yolov8. Firstly, Received Field Efficient Multiscale Attention (RFEMA) is designed to emphasize location-sensitive features and reduce the loss of detailed information. Secondly, Feature Concentration Module (FCM) is designed to integrate and enhance semantic features deep within the network. Finally, the Weighted Asymptotic Feature Pyramid Network (WAFPN) is designed to improve the fusion of multi-scale features. Experimental results show that on the steel and aluminum defect datasets, ARF-YOLO achieved a mean Average Precision (mAP) of 69.4\% and 61\%, respectively, which is 5.6\% and 2.7\% higher than YOLOv8. The proposed algorithm significantly outperforms comparative algorithms and can effectively detect defects on the surface of metal workpieces.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {198–204},
numpages = {7},
keywords = {Attention mechanism, Deep learning, Feature Pyramid Network, Metal workpieces, Surface defect detection},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747964,
author = {Zhou, Tianyu and Li, Li and Rasaily, Gaurav and Sen, Debjyoti and Fleck, Brian A.},
title = {AI-Enhanced Urban Wind Flow Modeling Using OpenFOAM},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747964},
doi = {10.1145/3747912.3747964},
abstract = {This research project proposes the development of a streamlined, open-source-based methodology for modeling urban wind flows using computational fluid dynamics (CFD), integrated with artificial intelligence (AI) to enhance workflow efficiency for the optimization of solution(s) use. The workflow begins by selecting an urban environment and acquiring high-resolution geometry via public datasets or point cloud scanning. Geometric data are converted into computational domains within OpenFOAM. A series of Reynolds-Averaged Navier-Stokes (RANS) simulations are conducted across varied wind directions and velocities to construct a comprehensive velocity field database.The outcome will be our practical toolchain enabling engineers, urban planners, and researchers to conduct efficient urban airflow analysis—supporting sustainable urban design, pollution dispersion studies, HVAC optimization and wind comfort assessments.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
