doi = {10.1145/3747912.3747957},
abstract = {With the continuous promotion of China's energy structure transformation and carbon neutrality goals, new energy vehicles (NEVs) have become the core direction of the development of China's automobile industry. In 2024, the sales volume of NEVs in China exceeded 12 million. Therefore, how to accurately understand the needs and satisfaction of the growing NEV user group has become an important issue faced by the current automotive industry. Combining the characteristics of the review data from Autohome, this paper proposes a user satisfaction evaluation method based on classified online review texts and ratings. For the online review texts and rating data of users of typical models on the Autohome website, after conducting deviation analysis through user ratings and emotional analysis evaluations, theme extraction and emotional analysis are performed on the effective review texts. The research results can provide decision support for NEV enterprises to formulate product improvement and marketing strategies.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {287–293},
numpages = {7},
keywords = {Emotional analysis, LDA, Natural language processing, New energy vehicles, Review texts and ratings, User satisfaction},
