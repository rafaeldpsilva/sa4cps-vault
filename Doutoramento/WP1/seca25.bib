}

@inproceedings{10.1145/3747912.3747936,
author = {Xia, Yongjun and Shi, Qiang and Ma, Yong and Ni, Hongyu},
title = {Dynamic modeling and simulation of high-voltage wire impacting flexible protection system},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747936},
doi = {10.1145/3747912.3747936},
abstract = {Flexible protection system has been increasingly applied in power transmission and transformation engineering for its advantages of low cost and short installation period. Accurate dynamic analysis of the impact of the broken wire on the nylon rope net is extremely important for the development and operation of the protection system. In this study, a cable element based on the absolute node coordinates formulation (ANCF) is used to describe transmission wire and nylon rope net. Based on the iterative force density method, the initial configuration of the network is obtained. In order to improve the simulation efficiency, the static condensation method is introduced. A contact search algorithm is proposed. Results from the simulation and experiments are compared to demonstrate the effectiveness of the proposed method and procedure.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
